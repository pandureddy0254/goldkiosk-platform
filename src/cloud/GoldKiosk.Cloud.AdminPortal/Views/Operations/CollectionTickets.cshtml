            </div>
            <div class="route-item">
                <div class="route-head"><span class="mono" style="color:var(--accent);">R-SHJ-01</span><span class="status-pill s-pending">Scheduled</span></div>
                <div class="route-meta">Raj Kumar · 3 stops · Al Wahda &rarr; Souk &rarr; Al Majaz</div>
                <div class="route-prog"><div class="route-fill" style="width:0%;"></div></div>
                <div class="route-foot"><span class="mono">0 / 3 stops</span><span class="mono">Starts 15:00</span></div>
            </div>
            <div class="route-item">
                <div class="route-head"><span class="mono" style="color:var(--accent);">R-NTH-01</span><span class="status-pill s-pending">Scheduled · tomorrow</span></div>
                <div class="route-meta">Salim Al Mazroui · 5 stops · RAK &rarr; UAQ &rarr; AJM &rarr; FUJ</div>
                <div class="route-prog"><div class="route-fill" style="width:0%;"></div></div>
                <div class="route-foot"><span class="mono">0 / 5 stops</span><span class="mono">May 24 · 09:00</span></div>
            </div>
        </div>
    </section>
</div>

