@model OfferReportViewModel
@using System.Globalization
@{
    var report = Model ?? throw new InvalidOperationException("This report view requires a model.");

    var inv = CultureInfo.InvariantCulture;

    ViewBag.PageTitle = "Offers <em>report.</em>";
    ViewBag.Eyebrow   = "R-09 · PROMOTIONAL OFFERS · LIVE";
    ViewBag.Subtitle  = "Active and inactive promotional offers across the kiosk fleet, with validity windows and discount terms.";
    ViewBag.ActiveNav = "reports";

    var rows = report.Rows ?? new List<OfferReportItem>();
    var from = report.From?.ToString("yyyy-MM-dd", inv) ?? "";
    var to   = report.To?.ToString("yyyy-MM-dd", inv) ?? "";

    var total = report.ActiveCount + report.InactiveCount;
    var activeShare = total > 0 ? ((decimal)report.ActiveCount / total * 100m) : 0m;
}

@section Head {
    @await Html.PartialAsync("_ReportDetailStyles")
}

<div class="breadcrumb">
    <a asp-controller="Reports" asp-action="Index">Reports library</a>
    <span class="sep">&rsaquo;</span>
    <span>R-09 &middot; Offers</span>
</div>

<form method="get" asp-controller="Reports" asp-action="Offer" class="report-filter">
    @Html.AntiForgeryToken()
    <label>From <input type="date" name="from" value="@from" /></label>
    <label>To <input type="date" name="to" value="@to" /></label>
    <button type="submit" class="btn btn-primary btn-sm">Apply</button>
    <a class="btn btn-ghost btn-sm" asp-controller="Reports" asp-action="Offer">Reset</a>
    <span style="flex:1;"></span>
    <button type="button" class="btn btn-ghost btn-sm">Export &middot; CSV</button>
    <button type="button" class="btn btn-ghost btn-sm">Export &middot; PDF</button>
</form>

<section class="card" style="margin-bottom:24px;">
    <header class="card-head">
        <div>
            <h2 class="card-title">Active vs inactive</h2>
            <div class="card-meta" style="margin-top:6px;">
                <span><span class="mono">@report.ActiveCount</span> active &middot;
                <span class="mono">@report.InactiveCount</span> inactive &middot;
                <span class="mono">@activeShare.ToString("F1", inv)%</span> active share</span>
            </div>
        </div>
    </header>
    <div class="card-body">
        <div class="chart">
            @* Single horizontal split bar: active / inactive *@
            <svg viewBox="0 0 1000 200" preserveAspectRatio="none">
                @{
                    var activeW = total > 0 ? (int)(900m * report.ActiveCount / total) : 450;
                    var inactiveW = total > 0 ? (int)(900m * report.InactiveCount / total) : 450;
                }
                <rect x="50" y="80" width="@activeW" height="40" fill="var(--success)" opacity="0.85" />
                <rect x="@(50 + activeW)" y="80" width="@inactiveW" height="40" fill="var(--ink-faint)" opacity="0.45" />
                <g font-family="var(--font-mono)" font-size="11" fill="var(--canvas)">
                    <text x="@(50 + activeW / 2)" y="105" text-anchor="middle">Active @report.ActiveCount</text>
                </g>
                <g font-family="var(--font-mono)" font-size="11" fill="var(--ink)">
                    <text x="@(50 + activeW + inactiveW / 2)" y="105" text-anchor="middle">Inactive @report.InactiveCount</text>
                </g>
            </svg>
        </div>
    </div>
</section>

<div class="kpi-strip">
    <div class="kpi-cell">
        <div class="kpi-label">Active offers<span class="dot" style="background:var(--success);"></span></div>
        <div class="kpi-value"><span class="mono">@report.ActiveCount</span></div>
        <div class="kpi-foot"><span class="label-suffix">currently redeemable</span></div>
    </div>
    <div class="kpi-cell">
        <div class="kpi-label">Inactive<span class="dot" style="background:var(--ink-faint);"></span></div>
        <div class="kpi-value"><span class="mono">@report.InactiveCount</span></div>
        <div class="kpi-foot"><span class="label-suffix">expired / paused</span></div>
    </div>
    <div class="kpi-cell">
        <div class="kpi-label">Total catalogue<span class="dot"></span></div>
        <div class="kpi-value"><span class="mono">@total</span></div>
        <div class="kpi-foot"><span class="label-suffix">all offers tracked</span></div>
    </div>
    <div class="kpi-cell">
        <div class="kpi-label">Active share<span class="dot" style="background:var(--success);"></span></div>
        <div class="kpi-value"><span class="mono">@activeShare.ToString("F1", inv)</span><span class="unit">%</span></div>
        <div class="kpi-foot"><span class="label-suffix">live ÷ total</span></div>
    </div>
</div>

<section class="card" style="margin-bottom:24px;">
    <header class="card-head">
        <div>
            <h2 class="card-title">Offer catalogue</h2>
            <div class="card-meta" style="margin-top:6px;"><span>Code &middot; discount &middot; validity window</span></div>
        </div>
    </header>
    <div style="overflow-x:auto;">
        <table class="report-table">
            <thead>
                <tr>
                    <th>Code</th>
                    <th>Description</th>
                    <th class="num">Discount</th>
                    <th>Validity start</th>
                    <th>Validity end</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @if (rows.Count == 0)
                {
                    <tr><td colspan="6" style="text-align:center; padding:32px 18px; color:var(--ink-faint);">No offers in range.</td></tr>
                }
                else
                {
                    foreach (var r in rows)
                    {
                        <tr>
                            <td><strong class="mono">@r.Code</strong></td>
                            <td>@r.Description</td>
                            <td class="num mono">@(r.DiscountPct.HasValue ? r.DiscountPct.Value.ToString("N2", inv) + "%" : "—")</td>
                            <td class="mono">@r.ValidityStart.ToString("yyyy-MM-dd", inv)</td>
                            <td class="mono">@r.ValidityEnd.ToString("yyyy-MM-dd", inv)</td>
                            <td>
                                @if (r.IsActive)
                                {
                                    <span class="pill s-ok">Active</span>
                                }
                                else
                                {
                                    <span class="pill s-mute">Inactive</span>
                                }
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</section>

@await Html.PartialAsync("_ReportMetaCard", new ReportMetaCardModel {
    ReportCode = "R-09",
    Matview    = "vw_promotional_offers",
    Cadence    = "Live view &middot; on each request",
    Rows       = rows.Count,
    SlaText    = "Live · no caching"
})
