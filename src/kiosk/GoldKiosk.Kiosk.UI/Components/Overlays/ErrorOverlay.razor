@if (Flow.Error is { } error)
{
    <div class="overlay-backdrop">
        <div class="overlay-panel glass">
            <div class="overlay-icon attention">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round">
                    <path d="M12 8v5" /><circle cx="12" cy="16.6" r="0.6" fill="currentColor" />
                    <path d="M10.3 3.9 2.8 17a2 2 0 0 0 1.7 3h15a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z" />
                </svg>
            </div>
            <h2 class="serif-hero overlay-title">@error.Title</h2>
            <p class="overlay-message">@error.Message</p>
            <div class="overlay-actions">
                @foreach (RecoveryChoice choice in error.Choices)
                {
                    <button class="@(choice.IsPrimary ? "btn-primary" : "btn-glass")"
                            @onclick="() => OnChoiceAsync(choice)">
                        @choice.Label
                    </button>
                }
            </div>
        </div>
    </div>
}
