@* ── Dependency diagram ───────────────────────────────────────────── *@
<section class="card" style="margin-bottom:32px;">
    <header class="card-head">
        <div>
            <h2 class="card-title">Service dependency graph</h2>
            <div class="card-meta" style="margin-top:6px;"><span class="dot-pulse" style="background:var(--accent);"></span><span>Live · auto-discovered from OpenTelemetry traces</span></div>
        </div>
        <div style="display:flex; gap:6px;">
            <button type="button" class="btn btn-ghost btn-sm">Expand</button>
            <button type="button" class="btn btn-ghost btn-sm">Download SVG</button>
        </div>
    </header>
    <div class="card-body">
        <div class="map-card">
            <svg viewBox="0 0 900 380" preserveAspectRatio="xMidYMid meet" width="100%" style="display:block;">
                <defs>
                    <marker id="arr" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto"><path d="M0,0 L10,5 L0,10 z" fill="var(--ink-faint)"/></marker>
                    <marker id="arrgold" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto"><path d="M0,0 L10,5 L0,10 z" fill="var(--accent)"/></marker>
                </defs>
                <g stroke="var(--line-strong)" stroke-width="1" fill="none" marker-end="url(#arr)">
                    <line x1="180" y1="80" x2="320" y2="80"/>
                    <line x1="180" y1="80" x2="320" y2="160"/>
                    <line x1="180" y1="80" x2="320" y2="240"/>
                    <line x1="180" y1="80" x2="320" y2="320"/>
                    <line x1="430" y1="80" x2="570" y2="80"/>
                    <line x1="430" y1="160" x2="570" y2="160"/>
                    <line x1="430" y1="160" x2="570" y2="240"/>
                    <line x1="430" y1="240" x2="570" y2="80"/>
                    <line x1="430" y1="240" x2="570" y2="240"/>
                    <line x1="430" y1="320" x2="570" y2="320"/>
                    <line x1="680" y1="80" x2="820" y2="160"/>
                    <line x1="680" y1="160" x2="820" y2="160"/>
                    <line x1="680" y1="240" x2="820" y2="240"/>
                    <line x1="680" y1="320" x2="820" y2="320"/>
                </g>
                <g stroke="var(--accent)" stroke-width="1.5" fill="none" marker-end="url(#arrgold)" stroke-dasharray="4 3">
                    <line x1="430" y1="80" x2="570" y2="160"/>
                </g>
                <g font-family="var(--font-mono)" font-size="11" fill="var(--ink)">
                    <g><rect x="60" y="60" width="120" height="40" rx="8" fill="var(--canvas-elevated)" stroke="var(--accent)" stroke-width="1.5"/><text x="120" y="85" text-anchor="middle">API gateway</text></g>
                    <g><rect x="320" y="60"  width="110" height="40" rx="6" fill="var(--canvas-elevated)" stroke="var(--line-strong)"/><text x="375" y="85"  text-anchor="middle">Auth</text></g>
                    <g><rect x="320" y="140" width="110" height="40" rx="6" fill="var(--canvas-elevated)" stroke="var(--line-strong)"/><text x="375" y="165" text-anchor="middle">Kiosk relay</text></g>
                    <g><rect x="320" y="220" width="110" height="40" rx="6" fill="var(--canvas-elevated)" stroke="var(--line-strong)"/><text x="375" y="245" text-anchor="middle">Reports</text></g>
                    <g><rect x="320" y="300" width="110" height="40" rx="6" fill="var(--canvas-elevated)" stroke="var(--line-strong)"/><text x="375" y="325" text-anchor="middle">CRM sync</text></g>
                    <g><rect x="570" y="60"  width="110" height="40" rx="6" fill="var(--canvas-elevated)" stroke="var(--line-strong)"/><text x="625" y="85"  text-anchor="middle">Tokeniser</text></g>
                    <g><rect x="570" y="140" width="110" height="40" rx="6" fill="var(--canvas-elevated)" stroke="var(--warning)" stroke-width="1.5"/><text x="625" y="165" text-anchor="middle">Matview</text></g>
                    <g><rect x="570" y="220" width="110" height="40" rx="6" fill="var(--canvas-elevated)" stroke="var(--line-strong)"/><text x="625" y="245" text-anchor="middle">Outbox</text></g>
                    <g><rect x="570" y="300" width="110" height="40" rx="6" fill="var(--canvas-elevated)" stroke="var(--line-strong)"/><text x="625" y="325" text-anchor="middle">Webhooks</text></g>
                    <g><rect x="820" y="60"  width="80" height="40" rx="6" fill="var(--canvas-sunken)" stroke="var(--line)"/><text x="860" y="85"  text-anchor="middle" fill="var(--ink-soft)">Key Vault</text></g>
                    <g><rect x="820" y="140" width="80" height="40" rx="6" fill="var(--canvas-sunken)" stroke="var(--line)"/><text x="860" y="165" text-anchor="middle" fill="var(--ink-soft)">SQL</text></g>
                    <g><rect x="820" y="220" width="80" height="40" rx="6" fill="var(--canvas-sunken)" stroke="var(--line)"/><text x="860" y="245" text-anchor="middle" fill="var(--ink-soft)">Svc Bus</text></g>
                    <g><rect x="820" y="300" width="80" height="40" rx="6" fill="var(--canvas-sunken)" stroke="var(--line)"/><text x="860" y="325" text-anchor="middle" fill="var(--ink-soft)">Partners</text></g>
                </g>
                <text x="120" y="40" font-size="10" font-family="var(--font-sans)" fill="var(--ink-faint)" text-anchor="middle" letter-spacing="0.14em">INGRESS</text>
                <text x="375" y="40" font-size="10" font-family="var(--font-sans)" fill="var(--ink-faint)" text-anchor="middle" letter-spacing="0.14em">APPLICATION</text>
                <text x="625" y="40" font-size="10" font-family="var(--font-sans)" fill="var(--ink-faint)" text-anchor="middle" letter-spacing="0.14em">DATA &amp; WORKERS</text>
                <text x="860" y="40" font-size="10" font-family="var(--font-sans)" fill="var(--ink-faint)" text-anchor="middle" letter-spacing="0.14em">INFRA</text>
            </svg>
        </div>
    </div>
</section>

@* TODO promote: svc-card grid + pulse rings — repeat here until lifted. *@
<style>
    .seg.seg-tabs { display:inline-flex; border:1px solid var(--line-strong); border-radius:var(--radius-md); overflow:hidden; background:var(--canvas-elevated); flex-wrap:wrap; }
    .seg.seg-tabs a { padding:8px 14px; font-size:13px; color:var(--ink-soft); border-right:1px solid var(--line); text-decoration:none; }
    .seg.seg-tabs a:last-child { border-right:none; }
    .seg.seg-tabs a.active { background: var(--ink); color: var(--canvas); }
    .seg.seg-tabs a:hover:not(.active) { background: var(--canvas-sunken); color: var(--ink); }
    .svc-grid { display:grid; grid-template-columns: repeat(auto-fill, minmax(260px, 1fr)); gap: 14px; margin-bottom: 32px; }
    .svc-card { position:relative; background: var(--canvas-elevated); border:1px solid var(--line); border-radius: var(--radius-lg); padding: 18px 20px; min-height: 140px; }
    .svc-card::before { content:""; position:absolute; top:0; left:0; width:32px; height:2px; background: var(--success); }
    .svc-card.s-warn::before { background: var(--warning); }
    .svc-card.s-bad::before  { background: var(--danger); }
    .svc-top { display:flex; align-items:center; gap:10px; margin-bottom:8px; }
    .svc-dot { width: 9px; height: 9px; border-radius: 50%; background: var(--success); position:relative; }
    .svc-card.s-warn .svc-dot { background: var(--warning); animation: pulse 1.8s ease-in-out infinite; }
    .svc-card.s-bad  .svc-dot { background: var(--danger);  animation: pulse 1.2s ease-in-out infinite; }
    .svc-card.s-warn .svc-dot::after, .svc-card.s-bad .svc-dot::after { content:""; position:absolute; inset:-4px; border-radius:50%; border:2px solid currentColor; opacity:0.4; animation: pulseRing 1.8s ease-out infinite; }
    .svc-name { font-family: var(--font-display); font-size: 17px; }
    .svc-version { font-size: 11px; color: var(--ink-faint); letter-spacing: 0.04em; margin-bottom: 14px; }
    .svc-stats { display:grid; grid-template-columns: repeat(3, 1fr); gap: 10px; padding-top:12px; border-top: 1px solid var(--line); }
    .svc-stats > div { display:flex; flex-direction: column; gap: 2px; }
    .svc-stats > div > span:first-child { font-size: 10px; letter-spacing: 0.06em; text-transform: uppercase; color: var(--ink-faint); }
    .svc-stats > div > span.mono { font-size: 13px; font-weight: 500; color: var(--ink); }
    .map-card { background: var(--canvas-sunken); border:1px solid var(--line); border-radius: var(--radius-md); padding: 8px; }
    @@keyframes pulseRing { 0% { transform: scale(0.8); opacity: 0.6; } 100% { transform: scale(1.6); opacity: 0; } }
</style>
