@inject IProfileService Profiles
@{
    var me       = await Profiles.GetCurrentAsync(Context.RequestAborted);
    var initials = me?.Initials ?? "??";
    var name     = me?.FullName  ?? "Signed out";
    var email    = me?.Email     ?? "";
    var roleLbl  = me?.Role == "superadmin"    ? "Superadmin"
                 : me?.Role == "sales_manager" ? "Sales Manager"
                 : "Sales Rep";
}
<header class="header">
    <button class="hamburger" type="button" aria-label="Open menu" aria-controls="app-sidebar"
            onclick="gkToggleSidebar(); return false;">
        <svg width="20" height="20" viewBox="0 0 20 20" fill="none" aria-hidden="true">
            <line x1="3"  y1="6"  x2="17" y2="6"  stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
            <line x1="3"  y1="10" x2="17" y2="10" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
            <line x1="3"  y1="14" x2="17" y2="14" stroke="currentColor" stroke-width="1.8" stroke-linecap="round"/>
        </svg>
    </button>
    <a class="brand" href="/">
        <span class="brand-mark"></span>
        <span class="brand-name">
            <span class="brand-primary">Gold <em>Kiosk</em></span>
            <span class="brand-suffix">CRM &middot; Internal sales portal</span>
        </span>
    </a>
    <form class="search" action="/Leads" method="get" role="search">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><circle cx="7" cy="7" r="5" stroke="currentColor" stroke-width="1.5"/><path d="M11 11L14 14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
        <input id="global-search" type="search" name="q" autocomplete="off" placeholder="Search leads, partners, activation keys&hellip;" />
        <kbd>&#8984;K</kbd>
    </form>
    <div class="header-right">
        <div class="notif-wrapper">
            <button class="icon-btn has-badge"
                    type="button"
                    data-action="toggle-notif-panel"
                    data-count="0"
                    aria-haspopup="dialog"
                    aria-expanded="false"
                    aria-label="Notifications"
                    title="Notifications"
                    onclick="gkTogglePanel(this, '.notif-panel'); return false;">
                <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
                    <path d="M9 2C6.5 2 4.5 4 4.5 6.5V9L3 11.5V12H15V11.5L13.5 9V6.5C13.5 4 11.5 2 9 2zM7.5 14C7.5 14.8 8.2 15.5 9 15.5C9.8 15.5 10.5 14.8 10.5 14"
                          stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
                <span class="badge"></span>
            </button>
            <div class="notif-panel" role="dialog" aria-label="Notifications" hidden>
                <header class="notif-panel-header">
                    <h2>Notifications</h2>
                    <a href="/Activity">See all</a>
                </header>
                <div class="notif-list">
                    <div class="notif-empty">No notifications.</div>
                </div>
            </div>
        </div>
        <button class="theme-toggle" type="button" data-action="toggle-theme" aria-label="Toggle theme" title="Toggle theme">
            <svg class="icon-sun" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <circle cx="12" cy="12" r="4"/>
                <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/>
            </svg>
            <svg class="icon-moon" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/>
            </svg>
        </button>
        <div class="user-menu">
            <button class="user-chip"
                    type="button"
                    data-action="toggle-user-menu"
                    aria-haspopup="menu"
                    aria-expanded="false"
                    aria-label="User menu"
                    onclick="gkTogglePanel(this, '.user-menu-panel'); return false;">
                <span class="avatar" aria-hidden="true">@initials</span>
                <span class="label">@name</span>
                <svg class="chevron" width="12" height="12" viewBox="0 0 12 12" fill="none" aria-hidden="true">
                    <path d="M2 4l4 4 4-4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
            </button>
            <div class="user-menu-panel" role="menu" hidden>
                <div class="user-menu-header">
                    <span class="avatar-lg" aria-hidden="true">@initials</span>
                    <div class="user-meta">
                        <div class="user-name">@name</div>
                        <div class="user-email">@email</div>
                        <span class="role-pill">@roleLbl</span>
                    </div>
                </div>
                <div class="user-menu-divider" role="separator"></div>
                <a class="user-menu-item" href="/Settings" role="menuitem">
                    <svg class="menu-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                        <circle cx="12" cy="12" r="3"/>
                        <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/>
                    </svg>
                    Workspace settings
                </a>
                @if (me?.IsManager == true)
                {
                    <a class="user-menu-item" href="/AuditLog" role="menuitem">
                        <svg class="menu-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                            <polyline points="14 2 14 8 20 8"/>
                            <line x1="16" y1="13" x2="8" y2="13"/>
                            <line x1="16" y1="17" x2="8" y2="17"/>
                            <polyline points="10 9 9 9 8 9"/>
                        </svg>
                        Audit log
                    </a>
                }
                <div class="user-menu-divider" role="separator"></div>
                <form class="user-menu-form" asp-controller="Account" asp-action="SignOut" method="post">
                    @Html.AntiForgeryToken()
                    <button class="user-menu-item danger" type="submit" role="menuitem">
                        <svg class="menu-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                            <polyline points="16 17 21 12 16 7"/>
                            <line x1="21" y1="12" x2="9" y2="12"/>
                        </svg>
                        Logout
                    </button>
                </form>
            </div>
        </div>
    </div>
</header>

@* Self-contained popover wiring for the user menu + notifications.
   Inline so it runs IMMEDIATELY at parse time (no defer race with the click
   the user fires the moment the page is interactive). Doesn't rely on site.js. *@
<script>
// Global popover toggle invoked via onclick= on the trigger buttons.
// Inline onclick is the most listener-race-proof option — it always runs
// for that specific click, no matter what other handlers exist.
window.gkTogglePanel = function (triggerEl, panelSel) {
    var p = document.querySelector(panelSel);
    if (!p) return;
    // Close all other open popovers first so only one is open at a time.
    document.querySelectorAll('.user-menu-panel, .notif-panel').forEach(function (other) {
        if (other !== p) {
            other.setAttribute('hidden', '');
            var otherTrigger = document.querySelector('[aria-controls="' + other.id + '"], [aria-haspopup][aria-expanded="true"]');
            // Best-effort: just reset both triggers' aria-expanded
            document.querySelectorAll('.user-menu .user-chip, [data-action="toggle-notif-panel"]').forEach(function (b) {
                if (!b.contains(other)) b.setAttribute('aria-expanded', 'false');
            });
        }
    });
    if (p.hasAttribute('hidden')) {
        p.removeAttribute('hidden');
        triggerEl.setAttribute('aria-expanded', 'true');
    } else {
        p.setAttribute('hidden', '');
        triggerEl.setAttribute('aria-expanded', 'false');
    }
};

// Close any open popover when clicking outside it or pressing Escape.
document.addEventListener('click', function (e) {
    document.querySelectorAll('.user-menu-panel, .notif-panel').forEach(function (p) {
        if (p.hasAttribute('hidden')) return;
        // Don't close if click was on the trigger (it has its own toggle handler).
        var insideTrigger = e.target.closest('[onclick*="' + (p.classList.contains('user-menu-panel') ? 'user-menu-panel' : 'notif-panel') + '"]');
        if (insideTrigger) return;
        if (p.contains(e.target)) return;
        p.setAttribute('hidden', '');
        // Reset aria-expanded on the matching trigger.
        var trig = document.querySelector(
            p.classList.contains('user-menu-panel')
                ? '.user-menu .user-chip'
                : '[data-action="toggle-notif-panel"]'
        );
        if (trig) trig.setAttribute('aria-expanded', 'false');
    });
});
document.addEventListener('keydown', function (e) {
    if (e.key !== 'Escape') return;
    document.querySelectorAll('.user-menu-panel, .notif-panel').forEach(function (p) {
        if (!p.hasAttribute('hidden')) {
            p.setAttribute('hidden', '');
            var trig = document.querySelector(
                p.classList.contains('user-menu-panel')
                    ? '.user-menu .user-chip'
                    : '[data-action="toggle-notif-panel"]'
            );
            if (trig) { trig.setAttribute('aria-expanded', 'false'); trig.focus(); }
        }
    });
});
</script>