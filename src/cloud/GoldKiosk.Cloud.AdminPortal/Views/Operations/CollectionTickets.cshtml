                    <g><circle cx="385" cy="220" r="14" fill="url(#ambglow)"/><circle cx="385" cy="220" r="5" fill="var(--warning)"/><text x="398" y="234" font-size="10" font-family="var(--font-mono)" fill="var(--ink-soft)">K-DXB-02 · 78%</text></g>
                    <g><circle cx="410" cy="195" r="14" fill="url(#ambglow)"/><circle cx="410" cy="195" r="5" fill="var(--warning)"/><text x="422" y="190" font-size="10" font-family="var(--font-mono)" fill="var(--ink-soft)">K-DXB-03 · 74%</text></g>
                    <g><circle cx="370" cy="240" r="10" fill="url(#grnglow)"/><circle cx="370" cy="240" r="4" fill="var(--success)"/></g>
                    <g><circle cx="280" cy="240" r="16" fill="url(#redglow)"/><circle cx="280" cy="240" r="6" fill="var(--danger)"/><text x="220" y="262" font-size="10" font-family="var(--font-mono)" fill="var(--ink)">K-AUH-01 · 88%</text></g>
                    <g><circle cx="260" cy="225" r="12" fill="url(#ambglow)"/><circle cx="260" cy="225" r="5" fill="var(--warning)"/></g>
                    <g><circle cx="420" cy="175" r="14" fill="url(#ambglow)"/><circle cx="420" cy="175" r="5" fill="var(--warning)"/><text x="432" y="172" font-size="10" font-family="var(--font-mono)" fill="var(--ink-soft)">K-SHJ-01 · 81%</text></g>
                    <g><circle cx="440" cy="140" r="10" fill="url(#grnglow)"/><circle cx="440" cy="140" r="4" fill="var(--success)"/></g>
                    <g><circle cx="455" cy="148" r="10" fill="url(#grnglow)"/><circle cx="455" cy="148" r="4" fill="var(--success)"/></g>
                    <g><circle cx="425" cy="160" r="10" fill="url(#grnglow)"/><circle cx="425" cy="160" r="4" fill="var(--success)"/></g>
                    <g><circle cx="490" cy="180" r="12" fill="url(#ambglow)"/><circle cx="490" cy="180" r="5" fill="var(--warning)"/></g>
                    <text x="300" y="35" font-size="10" font-family="var(--font-sans)" fill="var(--ink-faint)" text-anchor="middle" letter-spacing="0.14em">UAE FLEET · CASH LEVELS · LIVE</text>
                    <text x="450" y="345" font-size="9" font-family="var(--font-mono)" fill="var(--ink-faint)" text-anchor="end">Route R-DXB-01 · 6 stops · ETA 14:30</text>
                </svg>
            </div>
        </div>
    </section>

    <section class="card">
        <header class="card-head">
            <div>
                <h2 class="card-title">Active routes</h2>
                <div class="card-meta" style="margin-top:6px;"><span class="dot-pulse" style="background:var(--success);"></span><span>2 in progress</span></div>
            </div>
        </header>
        <div class="card-body" style="padding:18px 22px;">
