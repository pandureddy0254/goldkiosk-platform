@section Scripts {
    <script>
        function openSite(code) {
            var d = document.getElementById('locDrawer');
            var s = document.getElementById('locScrim');
            document.getElementById('drCode').textContent = code;
            d.classList.add('open'); s.classList.add('open'); d.setAttribute('aria-hidden', 'false');
        }
        function closeSite() {
            var d = document.getElementById('locDrawer');
            var s = document.getElementById('locScrim');
            d.classList.remove('open'); s.classList.remove('open'); d.setAttribute('aria-hidden', 'true');
        }
    </script>
}

@* TODO promote: drawer + loc-table — promote to main.css when reused. *@
<style>
    .seg.seg-tabs { display:inline-flex; border:1px solid var(--line-strong); border-radius:var(--radius-md); overflow:hidden; background:var(--canvas-elevated); flex-wrap:wrap; }
    .seg.seg-tabs a { padding:8px 14px; font-size:13px; color:var(--ink-soft); border-right:1px solid var(--line); text-decoration:none; }
    .seg.seg-tabs a:last-child { border-right:none; }
    .seg.seg-tabs a.active { background: var(--ink); color: var(--canvas); }
    .seg.seg-tabs a:hover:not(.active) { background: var(--canvas-sunken); color: var(--ink); }
    .loc-table tr { cursor: pointer; }
    .loc-table tr:hover td { background: var(--canvas-sunken); }
    .loc-table .row-code, .row-code { font-family: var(--font-mono); font-size: 12px; color: var(--accent); font-weight: 500; }
    .row-sub { font-size: 12px; color: var(--ink-faint); }

    .loc-drawer-scrim {
        position: fixed; inset: 0; background: rgba(0,0,0,0.32); opacity: 0; pointer-events: none;
        transition: opacity var(--dur-med); z-index: 90;
    }
    .loc-drawer-scrim.open { opacity: 1; pointer-events: auto; }
    .loc-drawer {
        position: fixed; top: 0; right: 0; height: 100vh; width: 560px; max-width: 92vw;
        background: var(--canvas); border-left: 1px solid var(--line);
        transform: translateX(102%); transition: transform var(--dur-med) var(--ease-out-quart);
        z-index: 91; display: flex; flex-direction: column; box-shadow: var(--shadow-md);
    }
    .loc-drawer.open { transform: translateX(0); }
    .loc-drawer-head { display:flex; justify-content:space-between; align-items:flex-start; padding: 22px 24px; border-bottom: 1px solid var(--line); }
    .loc-drawer-title { font-family: var(--font-display); font-size: 26px; font-weight: 400; margin: 4px 0 0; }
    .loc-drawer-body { flex: 1; overflow-y: auto; padding: 18px 24px 24px; }
    .loc-meta { display: grid; grid-template-columns: 1fr; gap: 10px; margin: 12px 0 22px; }
    .loc-meta > div { display: grid; grid-template-columns: 130px 1fr; gap: 14px; padding: 8px 0; border-bottom: 1px solid var(--line); font-size: 13px; }
    .loc-meta dt { color: var(--ink-faint); text-transform: uppercase; letter-spacing: 0.08em; font-size: 11px; align-self: center; }
    .loc-meta dd { margin: 0; color: var(--ink); }
    .loc-section-h { font-family: var(--font-display); font-size: 18px; font-weight: 400; margin: 22px 0 6px; }
    .loc-drawer-foot { display:flex; gap:8px; justify-content:flex-end; padding-top: 22px; }
</style>
