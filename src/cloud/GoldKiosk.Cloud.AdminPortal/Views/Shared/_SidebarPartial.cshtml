@model GoldKiosk.Cloud.AdminPortal.Models.Layout.SidebarViewModel
@{
    string ActiveClass(string slug) => Model.ActiveNav == slug ? "nav-link active" : "nav-link";
}

<aside class="sidebar">
    <nav class="sidebar-nav" aria-label="Primary">

        <div class="nav-section">
            <div class="nav-section-title">Overview</div>
            <a class="@ActiveClass("dashboard")" asp-controller="Home" asp-action="Index">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><rect x="2" y="2" width="5" height="5" rx="1" stroke="currentColor" stroke-width="1.5"/><rect x="9" y="2" width="5" height="5" rx="1" stroke="currentColor" stroke-width="1.5"/><rect x="2" y="9" width="5" height="5" rx="1" stroke="currentColor" stroke-width="1.5"/><rect x="9" y="9" width="5" height="5" rx="1" stroke="currentColor" stroke-width="1.5"/></svg>
                Dashboard
            </a>
        </div>

        <div class="nav-section">
            <div class="nav-section-title">Fleet</div>
            <a class="@ActiveClass("kiosks")" asp-controller="KioskManagement" asp-action="KioskConfiguration">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><rect x="3" y="2" width="10" height="13" rx="1" stroke="currentColor" stroke-width="1.5"/><line x1="3" y1="5" x2="13" y2="5" stroke="currentColor" stroke-width="1.5"/><circle cx="8" cy="12" r="0.8" fill="currentColor"/></svg>
                Kiosks
            </a>
            <a class="@ActiveClass("users")" asp-controller="UserManagement" asp-action="Index">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><circle cx="8" cy="5" r="2.5" stroke="currentColor" stroke-width="1.5"/><path d="M3 14C3 11.5 5 10 8 10C11 10 13 11.5 13 14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                Users
            </a>
            <a class="@ActiveClass("customers")" asp-controller="CustomerManagement" asp-action="CustomerDetails">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 6L8 3L13 6V13H3V6Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>
                Customers
            </a>
            <a class="@ActiveClass("merchants")" asp-controller="MerchantManagement" asp-action="ManageMerchants">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 5H13V13H3V5z" stroke="currentColor" stroke-width="1.5"/><path d="M3 5L5 2H11L13 5" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>
                Merchants
            </a>
        </div>

        <div class="nav-section">
            <div class="nav-section-title">Commerce</div>
            <a class="@ActiveClass("sales")" asp-controller="Sales" asp-action="PreciousMetal">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><circle cx="8" cy="8" r="6" stroke="currentColor" stroke-width="1.5"/><text x="8" y="11" text-anchor="middle" font-size="8" font-family="serif" fill="currentColor">$</text></svg>
                Sales
            </a>
            <a class="@ActiveClass("vouchers")" asp-controller="VoucherManagement" asp-action="VoucherConfiguration">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 5L8 2L13 5V11L8 14L3 11V5Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>
                Vouchers
            </a>
            <a class="@ActiveClass("reports")" asp-controller="Reports" asp-action="Index">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M2 13L5 8L8 10L11 5L14 9" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                Reports
            </a>
        </div>

        <div class="nav-section">
            <div class="nav-section-title">Support &amp; ops</div>
            <a class="@ActiveClass("helpdesk")" asp-controller="HelpDesk" asp-action="Ticket">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><circle cx="8" cy="8" r="6" stroke="currentColor" stroke-width="1.5"/><path d="M8 5V8L10 10" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                Helpdesk
            </a>
            <a class="@ActiveClass("feedback")" asp-controller="Feedback" asp-action="Index">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 4H13V12H3V4z" stroke="currentColor" stroke-width="1.5"/><line x1="3" y1="6" x2="13" y2="6" stroke="currentColor" stroke-width="1.5"/></svg>
                Feedback
            </a>
            <a class="@ActiveClass("audit")" asp-controller="AuditLogs" asp-action="Index">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M8 2L14 5V8C14 11.5 11.5 13.5 8 14C4.5 13.5 2 11.5 2 8V5L8 2Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>
                Audit logs
            </a>
            <a class="@ActiveClass("monitoring")" asp-controller="Monitoring" asp-action="ApiHealthMonitoring">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><circle cx="8" cy="8" r="3" stroke="currentColor" stroke-width="1.5"/><circle cx="8" cy="8" r="6" stroke="currentColor" stroke-width="1.5" stroke-dasharray="1 2"/></svg>
                Monitoring
            </a>
            <a class="@ActiveClass("operations")" asp-controller="Operations" asp-action="Index">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M5 3V5H3V13H13V5H11V3M5 3H11M5 3V2H11V3" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>
                Operations
            </a>
        </div>

        <div class="nav-section">
            <div class="nav-section-title">Administration</div>
            <a class="@ActiveClass("user-management")" asp-controller="UserManagement" asp-action="Index">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><circle cx="6" cy="5" r="2" stroke="currentColor" stroke-width="1.5"/><circle cx="11" cy="6" r="1.5" stroke="currentColor" stroke-width="1.5"/><path d="M2 13C2 11 4 10 6 10C8 10 10 11 10 13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/><path d="M10 12C10 11 11 10.5 12 10.5C13 10.5 14 11 14 12.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                User management
            </a>
            <a class="@ActiveClass("roles")" asp-controller="RolesPermissions" asp-action="Index">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><rect x="3" y="6" width="10" height="8" rx="1" stroke="currentColor" stroke-width="1.5"/><path d="M5 6V4C5 2.9 5.9 2 7 2H9C10.1 2 11 2.9 11 4V6" stroke="currentColor" stroke-width="1.5"/></svg>
                Roles &amp; permissions
            </a>
            <a class="@ActiveClass("api-credentials")" asp-controller="ApiCredentials" asp-action="Index">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M10 7C10 5.3 8.7 4 7 4S4 5.3 4 7 5.3 10 7 10C7.5 10 8 9.9 8.4 9.7L11 12.3L12.3 11L9.7 8.4C9.9 8 10 7.5 10 7Z" stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"/></svg>
                API credentials
            </a>
            <a class="@ActiveClass("tenant-settings")" asp-controller="TenantSettings" asp-action="Index">
                <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><circle cx="8" cy="8" r="6" stroke="currentColor" stroke-width="1.5"/><path d="M5 8L7 10L11 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                Tenant settings
            </a>
        </div>
    </nav>

    <div class="sidebar-foot">
        <div class="tenant-card">
            <div class="eyebrow" style="margin-bottom:6px;">Tenant</div>
            <div style="font-family:var(--font-display); font-size:17px;">@Model.TenantLegalName</div>
            <div style="font-size:12px; color:var(--ink-faint); margin-top:2px;">@Model.TenantRegion</div>
        </div>
    </div>
</aside>
