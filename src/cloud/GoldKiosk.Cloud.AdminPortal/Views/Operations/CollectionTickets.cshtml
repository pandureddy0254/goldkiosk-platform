@{
    ViewBag.PageTitle = "Cash <em>collections.</em>";
    ViewBag.Eyebrow   = "Operations · Field logistics";
    ViewBag.Subtitle  = "Routes, cassette levels, and scheduled pickups across the fleet. Generate optimised routes when kiosks approach 70% capacity.";
    ViewBag.ActiveNav = "operations";
}

@* ── Operations sub-nav + primary action ───────────────────────────── *@
<div style="display:flex; gap:10px; align-items:center; flex-wrap:wrap; margin: -16px 0 22px;">
    <div class="seg seg-tabs">
        <a class="active" asp-controller="Operations" asp-action="CollectionTickets">Collections</a>
        <a asp-controller="Operations" asp-action="MaintenanceTickets">Maintenance</a>
        <a asp-controller="Operations" asp-action="TechnicianManagement">Technicians</a>
        <a asp-controller="Operations" asp-action="SystemHealthCheck">System health</a>
        <a asp-controller="Operations" asp-action="DeploymentTickets">Deployment</a>
        <a asp-controller="Operations" asp-action="LocationConfiguration">Locations</a>
    </div>
    <span style="flex:1;"></span>
    <button type="button" class="btn btn-primary btn-sm" data-action="open-modal" data-target="addRunModal">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M7 3V11M3 7H11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
        Generate route
    </button>
</div>

@* ── KPI strip ───────────────────────────────────────────────────────── *@
<div class="kpi-strip">
    <div class="kpi-cell">
        <div class="kpi-label">Need collection<span class="dot" style="background:var(--warning);"></span></div>
        <div class="kpi-value mono">16</div>
        <div class="kpi-foot"><span class="label-suffix">&ge; 70% capacity</span></div>
    </div>
    <div class="kpi-cell">
        <div class="kpi-label">Total cash · fleet<span class="dot"></span></div>
        <div class="kpi-value mono">2,148,420<span class="unit">AED</span></div>
        <div class="kpi-foot"><span class="delta delta-up">&#9650; 8.2%</span><span class="label-suffix">vs 7d avg</span></div>
    </div>
    <div class="kpi-cell">
        <div class="kpi-label">Routes today<span class="dot" style="background:var(--success);"></span></div>
        <div class="kpi-value mono">4</div>
        <div class="kpi-foot"><span class="label-suffix">2 active · 1 scheduled</span></div>
    </div>
    <div class="kpi-cell">
        <div class="kpi-label">Collected today<span class="dot" style="background:var(--success);"></span></div>
        <div class="kpi-value mono">842,180<span class="unit">AED</span></div>
        <div class="kpi-foot"><span class="delta delta-up">&#9650; 14%</span><span class="label-suffix">target · AED 900k</span></div>
    </div>
</div>

@* ── Map + active routes ────────────────────────────────────────────── *@
<div class="split-2-1">
    <section class="card">
        <header class="card-head">
            <div>
                <h2 class="card-title">Fleet map · cash levels</h2>
                <div class="card-meta" style="margin-top:6px;">
                    <span><span class="sw" style="background:var(--success);"></span>Low</span>
                    <span><span class="sw" style="background:var(--warning);"></span>&ge; 70%</span>
                    <span><span class="sw" style="background:var(--danger);"></span>&ge; 90%</span>
                </div>
            </div>
            <div class="seg"><button class="active" type="button">Map</button><button type="button">List</button></div>
        </header>
        <div class="card-body">
            <div class="map-card">
                <svg viewBox="0 0 600 360" preserveAspectRatio="xMidYMid meet" width="100%" style="display:block;">
                    <defs>
                        <radialGradient id="redglow" cx="50%" cy="50%" r="50%"><stop offset="0%" stop-color="var(--danger)" stop-opacity="0.45"/><stop offset="100%" stop-color="var(--danger)" stop-opacity="0"/></radialGradient>
                        <radialGradient id="ambglow" cx="50%" cy="50%" r="50%"><stop offset="0%" stop-color="var(--warning)" stop-opacity="0.4"/><stop offset="100%" stop-color="var(--warning)" stop-opacity="0"/></radialGradient>
                        <radialGradient id="grnglow" cx="50%" cy="50%" r="50%"><stop offset="0%" stop-color="var(--success)" stop-opacity="0.35"/><stop offset="100%" stop-color="var(--success)" stop-opacity="0"/></radialGradient>
                    </defs>
                    <path d="M40,120 Q120,90 220,80 Q340,70 440,110 Q540,140 560,220 Q540,300 440,320 Q320,330 220,320 Q120,310 70,260 Q30,200 40,120 Z" fill="var(--canvas-sunken)" stroke="var(--line-strong)" stroke-width="1"/>
                    <path d="M380,140 Q420,160 430,210 Q420,260 380,270 Q340,260 340,210 Q340,160 380,140 Z" fill="var(--canvas-elevated)" stroke="var(--accent)" stroke-width="1" stroke-dasharray="3 4" opacity="0.5"/>
                    <path d="M395,205 Q360,170 320,175 Q260,180 230,210 Q200,250 240,270" fill="none" stroke="var(--accent)" stroke-width="1.4" stroke-dasharray="4 4" opacity="0.7"/>
