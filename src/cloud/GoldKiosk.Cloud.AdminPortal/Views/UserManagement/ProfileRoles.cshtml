@* ── Pending invitations (live) ───────────────────────────────────── *@
@if (pendingInvites.Count > 0)
{
    <section class="card" style="margin-bottom:24px;">
        <header class="card-head">
            <div>
                <h2 class="card-title">Pending invitations · @pendingInvites.Count</h2>
                <div class="card-meta" style="margin-top:6px;">
                    <span>Outstanding invites — token expires 7 days after send</span>
                </div>
            </div>
            <a class="btn btn-ghost btn-sm" asp-controller="UserManagement" asp-action="Invite">+ New invite</a>
        </header>
        <div style="overflow-x:auto;">
            <table class="user-table">
                <thead>
                    <tr>
                        <th style="width:32%;">Invitee</th>
                        <th style="width:18%;">Role</th>
                        <th style="width:16%;">Invited</th>
                        <th style="width:16%;">Expires</th>
                        <th style="width:8%;">Resent</th>
                        <th style="width:10%; text-align:right; padding-right:22px;">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var inv in pendingInvites)
                    {
                        var initials = string.Concat(inv.FullName.Split(' ', StringSplitOptions.RemoveEmptyEntries)
                            .Select(t => t[0])).ToUpperInvariant();
                        if (string.IsNullOrWhiteSpace(initials)) initials = inv.InviteeEmail.Substring(0, 1).ToUpperInvariant();
                        <tr>
                            <td>
                                <div class="user-cell">
                                    <span class="avatar">@initials</span>
                                    <div class="meta">
                                        <strong>@(string.IsNullOrWhiteSpace(inv.FullName) ? inv.InviteeEmail : inv.FullName)</strong>
                                        <span>@inv.InviteeEmail</span>
                                    </div>
                                </div>
                            </td>
                            <td><span class="role-pill">@inv.RoleName</span></td>
                            <td class="mono">@inv.InvitedAt.ToString("dd MMM HH:mm")</td>
                            <td class="mono">@inv.ExpiresAt.ToString("dd MMM HH:mm")</td>
                            <td class="mono">@inv.ResentCount</td>
                            <td style="text-align:right; padding-right:22px;">
                                <form asp-controller="UserManagement" asp-action="ResendInvite" method="post" style="display:inline;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="invitationId" value="@inv.Id" />
                                    <button type="submit" class="btn btn-ghost btn-sm">Resend</button>
                                </form>
                                <form asp-controller="UserManagement" asp-action="RevokeInvite" method="post" style="display:inline;">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="invitationId" value="@inv.Id" />
                                    <button type="submit" class="btn btn-ghost btn-sm" style="color:var(--danger);">Revoke</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </section>
}

