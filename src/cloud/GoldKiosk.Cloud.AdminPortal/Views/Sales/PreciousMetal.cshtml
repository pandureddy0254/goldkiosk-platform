@using GoldKiosk.Cloud.AdminPortal.Models
@using System.Globalization
@model SalesClientList
@{
    ViewBag.PageTitle = "Precious metal <em>sales.</em>";
    ViewBag.Eyebrow   = "COMMERCE · SALES REGISTER";
    ViewBag.Subtitle  = "Every sale processed across the kiosk fleet — weighed, XRF-tested, priced, and payable. Net amounts settle against the merchant wallet within 60 minutes.";
    ViewBag.ActiveNav = "sales";
    ViewBag.PageHeadActions =
        $"<a class=\"btn btn-ghost btn-sm\" href=\"/Sales/ExportClientsCsv?kind=precious_sale" +
            (ViewBag.SearchTerm is string s && !string.IsNullOrEmpty(s) ? $"&search={System.Net.WebUtility.UrlEncode(s)}" : "") +
            (ViewBag.Source is string src && !string.IsNullOrEmpty(src) ? $"&source={System.Net.WebUtility.UrlEncode(src)}" : "") +
            "\">Export CSV</a>" +
        "<button class=\"btn btn-ghost btn-sm\" type=\"button\">Report</button>";

    var searchTerm  = ViewBag.SearchTerm as string;
    var sourceTerm  = ViewBag.Source     as string;
    var fromDate    = ViewBag.From as DateTime?;
    var toDate      = ViewBag.To   as DateTime?;
    var showJunk    = ViewBag.ShowJunkOnly   as bool? ?? false;
    var showActive  = ViewBag.ShowActiveOnly as bool? ?? true;
    var pageSize    = ViewBag.PageSize as int? ?? 10;

    // Mock-data heuristics for the prototype look — pure presentation, no controller change.
    string[] kiosks  = { "K-DXB-01","K-DXB-02","K-DXB-03","K-AUH-01","K-AUH-02","K-SHJ-03","K-RAK-01","K-AJM-01","K-FUJ-01","K-UAQ-01" };
    string[] purities = { "p-22","p-21","p-18","p-ag" };
    string[] purityLbls = { "22K","21K","18K","Silver" };
    string KioskFor(Guid id) => kiosks[Math.Abs(id.GetHashCode()) % kiosks.Length];
    int PurityIxFor(Guid id) => Math.Abs(id.GetHashCode()) % purities.Length;
    decimal WeightFor(decimal amount)
    {
        if (amount <= 0) return 0;
        // 22K spot ~ 280 AED/g — approximate weight bucket for display only.
        return Math.Round(amount / 280m, 2);
    }
    string PayoutLabel(string? source)
    {
        var src = (source ?? "").ToLowerInvariant();
        if (src.Contains("cash")) return "Cash dispense";
        return "Bank transfer";
    }
    static (string color, string initials) AvatarFor(Guid g)
    {
        var palettes = new[] {
            "linear-gradient(135deg,#b8941f,#7a610f)",
            "linear-gradient(135deg,#2a5d8c,#1c3e5d)",
            "linear-gradient(135deg,#a83232,#7a2424)",
            "linear-gradient(135deg,#c47419,#8b520f)",
            "linear-gradient(135deg,#2a7d4f,#1c5d3a)",
            "linear-gradient(135deg,#75716a,#4a4845)",
        };
        var hex = g.ToString("N");
        var idx = Math.Abs((hex[0] - '0' + hex[1])) % palettes.Length;
        var inits = $"{char.ToUpper(hex[0])}{char.ToUpper(hex[2])}";
        return (palettes[idx], inits);
    }

    // Aggregate KPIs from the in-view rows.
    var totalNet = Model.Items.Sum(r => r.NetPayout);
    var totalGross = Model.Items.Sum(r => r.TotalAmount);
    var totalDeductions = totalGross - totalNet;
    var avgPrice = Model.Items.Count > 0 ? (totalGross / Math.Max(1m, Model.Items.Sum(r => WeightFor(r.TotalAmount)))) : 0m;
    var settled = Model.Items.Count(r => string.Equals(r.Status, "settled", StringComparison.OrdinalIgnoreCase));
    var settlementPct = Model.Items.Count > 0 ? (decimal)settled * 100m / Model.Items.Count : 0m;
    var totalWeight = Model.Items.Sum(r => WeightFor(r.TotalAmount));
}

<nav class="sub-nav" aria-label="Sales module">
    <a class="sub-link active" asp-controller="Sales" asp-action="PreciousMetal">Precious metals</a>
    <a class="sub-link" asp-controller="Sales" asp-action="PawnSales">Pawn loans</a>
</nav>

<div class="kpi-strip">
    <div class="kpi-cell">
        <div class="kpi-label">Sold · in view<span class="dot"></span></div>
        <div class="kpi-value mono">@totalNet.ToString("N0", CultureInfo.InvariantCulture)<span class="unit">AED</span></div>
        <div class="kpi-foot"><span class="label-suffix">gross <span class="mono">@totalGross.ToString("N0", CultureInfo.InvariantCulture)</span> · ded <span class="mono">@totalDeductions.ToString("N0", CultureInfo.InvariantCulture)</span></span></div>
    </div>
    <div class="kpi-cell">
        <div class="kpi-label">Weight · in view<span class="dot" style="background:var(--accent);"></span></div>
        <div class="kpi-value mono">@totalWeight.ToString("N1", CultureInfo.InvariantCulture)<span class="unit">g</span></div>
        <div class="kpi-foot"><span class="label-suffix">avg lot · <span class="mono">@(Model.Items.Count > 0 ? (totalWeight / Model.Items.Count).ToString("N2", CultureInfo.InvariantCulture) : "0.00")</span> g</span></div>
    </div>
    <div class="kpi-cell">
        <div class="kpi-label">Avg price · view<span class="dot" style="background:var(--danger);"></span></div>
        <div class="kpi-value mono">@avgPrice.ToString("N2", CultureInfo.InvariantCulture)<span class="unit">AED / g</span></div>
        <div class="kpi-foot"><span class="label-suffix">across all purities</span></div>
    </div>
    <div class="kpi-cell">
        <div class="kpi-label">Settlement rate<span class="dot" style="background:var(--success);"></span></div>
        <div class="kpi-value mono">@settlementPct.ToString("N1", CultureInfo.InvariantCulture)<span class="unit">%</span></div>
        <div class="kpi-foot"><span class="label-suffix"><span class="mono">@settled</span> of <span class="mono">@Model.Items.Count</span> settled</span></div>
    </div>
</div>

<form method="get" asp-controller="Sales" asp-action="PreciousMetal" class="filter-bar" role="search">
    <div class="filter-bar-left">
        <div class="search-inline">
            <svg width="14" height="14" viewBox="0 0 16 16" fill="none"><circle cx="7" cy="7" r="5" stroke="currentColor" stroke-width="1.5"/><path d="M11 11L14 14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
            <input type="text" name="search" value="@searchTerm" placeholder="Filter by TX-ID, customer, kiosk…" />
        </div>

        <select name="source" class="select-inline">
            <option value="">Source · All</option>
            @foreach (var item in Model.SourceDropdown ?? [])
            {
                <option value="@item.Value" selected="@(sourceTerm == item.Value)">@item.Text</option>
            }
        </select>

        <label class="date-inline"><span>From</span><input type="date" name="from" value="@(fromDate?.ToString("yyyy-MM-dd"))" /></label>
        <label class="date-inline"><span>To</span><input type="date" name="to" value="@(toDate?.ToString("yyyy-MM-dd"))" /></label>

        <input type="hidden" name="pageSize" value="@pageSize" />
        <input type="hidden" name="pageNo" value="1" />

        <button type="submit" class="btn btn-primary btn-sm">Apply</button>
        <a class="btn btn-ghost btn-sm" asp-controller="Sales" asp-action="PreciousMetal">Reset</a>

        <label class="check-inline">
            <input type="checkbox" name="showJunkOnly" value="true" @(showJunk ? "checked" : "") />
            <span>Junk</span>
        </label>
        <label class="check-inline">
            <input type="checkbox" name="showActiveOnly" value="true" @(showActive ? "checked" : "") />
            <span>Active</span>
        </label>
    </div>
    <div class="filter-bar-right">
        <span class="filter-meta"><span class="mono">@Model.Items.Count</span> of <span class="mono">@Model.PageCount</span> shown · page <span class="mono">@(ViewBag.PageNo ?? 1)</span></span>
    </div>
</form>

<div class="seg-row" aria-label="Status tabs">
    <div class="seg">
        <button type="button" class="active">All · <span class="mono">@(Model.AllClients)</span></button>
        <button type="button">Registered · <span class="mono">@Model.RegisteredClients</span></button>
        <button type="button">In process · <span class="mono">@Model.ProcessClients</span></button>
        <button type="button">Unpaid · <span class="mono">@Model.UnpaidClients</span></button>
        <button type="button">Closed · <span class="mono">@Model.ClosedClients</span></button>
    </div>
</div>

<section class="card">
    <div style="overflow-x:auto;">
        <table class="user-table">
            <thead>
                <tr>
                    <th>TX-ID</th>
                    <th>Date · time</th>
                    <th>Customer</th>
                    <th>Kiosk</th>
                    <th class="num-th">Weight g</th>
                    <th>Purity</th>
                    <th class="num-th">Gross AED</th>
                    <th class="num-th">Deductions</th>
                    <th class="num-th">Net AED</th>
                    <th>Payout</th>
                    <th>Status</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Items.Count == 0)
                {
                    <tr><td colspan="11"><div class="empty-row">No precious-metal sales in this filter.</div></td></tr>
                }
                else
                {
                    foreach (var row in Model.Items)
                    {
                        var av = AvatarFor(row.CustomerId);
                        var weight = WeightFor(row.TotalAmount);
                        var deductions = row.TotalAmount - row.NetPayout;
                        var ix = PurityIxFor(row.TransactionId);
                        var pCls = purities[ix];
                        var pLbl = purityLbls[ix];
                        var statusCls = (row.Status ?? "").ToLowerInvariant() switch {
                            "settled" or "active" or "closed" or "registered" => "s-active",
                            "pending" or "in_process" or "process" or "unpaid" => "s-pending",
                            _ => "s-disabled"
                        };
                        <tr>
                            <td class="mono">@row.TransactionCode</td>
                            <td class="mono">@row.OccurredOn.ToString("dd MMM · HH:mm", CultureInfo.InvariantCulture)</td>
                            <td>
                                <div class="user-cell">
                                    <span class="avatar" style="background:@av.color; color:#fff;">@av.initials</span>
                                    <div class="meta">
                                        <strong>@row.CustomerCode</strong>
                                        <span class="mono">@row.MobileMasked</span>
                                    </div>
                                </div>
                            </td>
                            <td class="mono">@KioskFor(row.TransactionId)</td>
                            <td class="mono num-td">@weight.ToString("N2", CultureInfo.InvariantCulture)</td>
                            <td><span class="purity-pill @pCls">@pLbl</span></td>
                            <td class="mono num-td">@row.TotalAmount.ToString("N2", CultureInfo.InvariantCulture)</td>
                            <td class="mono num-td">@deductions.ToString("N2", CultureInfo.InvariantCulture)</td>
                            <td class="mono num-td">@row.NetPayout.ToString("N2", CultureInfo.InvariantCulture)</td>
                            <td>@PayoutLabel(row.Source)</td>
                            <td><span class="status-pill @statusCls">@row.Status</span></td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
    @if (Model.Items.Count > 0)
    {
        <div class="table-foot">
            <span>Showing <span class="mono">@Model.Items.Count</span> · sorted by date, descending</span>
            <div class="seg sm">
                @{
                    var pn = ViewBag.PageNo as int? ?? 1;
                    var pc = Math.Max(1, Model.PageCount);
                }
                @if (pn > 1)
                {
                    <a class="page-btn" href="?pageSize=@pageSize&pageNo=@(pn-1)@(string.IsNullOrEmpty(searchTerm) ? "" : "&search=" + System.Net.WebUtility.UrlEncode(searchTerm))">‹</a>
                }
                else
                {
                    <button type="button" class="page-btn" disabled>‹</button>
                }
                <button type="button" class="page-btn active mono">@pn</button>
                @if (Model.Items.Count >= pageSize)
                {
                    <a class="page-btn" href="?pageSize=@pageSize&pageNo=@(pn+1)@(string.IsNullOrEmpty(searchTerm) ? "" : "&search=" + System.Net.WebUtility.UrlEncode(searchTerm))">›</a>
                }
                else
                {
                    <button type="button" class="page-btn" disabled>›</button>
                }
            </div>
        </div>
    }
</section>

@section Head {
<style>
/* TODO promote — sub-nav, filter-bar, seg, purity pill, table-foot.
   Shared with Pawn loans + Vouchers Redemption log. */

.sub-nav { display: flex; gap: 26px; padding: 0 2px; margin: 0 0 28px; border-bottom: 1px solid var(--line); }
.sub-link { padding: 12px 2px; font-size: var(--fs-13); font-weight: 500; color: var(--ink-faint); border-bottom: 2px solid transparent; text-decoration: none; transition: color var(--dur-fast), border-color var(--dur-fast); }
.sub-link:hover { color: var(--ink); }
.sub-link.active { color: var(--accent); border-bottom-color: var(--accent); }

.filter-bar { display: flex; align-items: center; justify-content: space-between; gap: 16px; padding: 22px 4px 16px; flex-wrap: wrap; margin: 0; }
.filter-bar-left  { display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
.filter-bar-right { display: flex; align-items: center; gap: 12px; }
.filter-meta      { font-size: var(--fs-12); color: var(--ink-faint); }
.search-inline { display: flex; align-items: center; gap: 8px; padding: 7px 12px; min-width: 260px; background: var(--canvas-elevated); border: 1px solid var(--line); border-radius: var(--radius-md); color: var(--ink-faint); }
.search-inline input { background: transparent; border: none; outline: none; width: 100%; font-size: var(--fs-13); color: var(--ink); font-family: var(--font-sans); }

.select-inline {
    padding: 7px 28px 7px 12px; min-width: 160px;
    background: var(--canvas-elevated);
    border: 1px solid var(--line);
    border-radius: var(--radius-md);
    color: var(--ink); font-size: var(--fs-13); font-family: var(--font-sans);
    appearance: none;
    -webkit-appearance: none;
    background-image: linear-gradient(45deg, transparent 50%, var(--ink-faint) 50%),
                      linear-gradient(135deg, var(--ink-faint) 50%, transparent 50%);
    background-position: calc(100% - 14px) 50%, calc(100% - 9px) 50%;
    background-size: 5px 5px, 5px 5px;
    background-repeat: no-repeat;
}
.select-inline:focus { outline: none; border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-ring); }

.date-inline { display: flex; flex-direction: column; gap: 2px; }
.date-inline > span { font-size: 10px; color: var(--ink-faint); letter-spacing: var(--tracking-wider); text-transform: uppercase; }
.date-inline input { padding: 6px 10px; background: var(--canvas-elevated); border: 1px solid var(--line); border-radius: var(--radius-md); color: var(--ink); font-size: var(--fs-13); font-family: var(--font-mono); }
.date-inline input:focus { outline: none; border-color: var(--accent); box-shadow: 0 0 0 3px var(--accent-ring); }

.check-inline { display: inline-flex; align-items: center; gap: 6px; font-size: var(--fs-13); color: var(--ink-soft); }
.check-inline input { width: auto; }

.seg-row { padding: 0 4px 22px; }
.seg { display: inline-flex; align-items: center; gap: 2px; padding: 4px; background: var(--canvas-elevated); border: 1px solid var(--line); border-radius: var(--radius-md); }
.seg button {
    padding: 6px 12px; font-size: var(--fs-13); font-weight: 500;
    color: var(--ink-soft); background: transparent;
    border: none; border-radius: 6px; cursor: pointer;
}
.seg button:hover { color: var(--ink); }
.seg button.active { background: var(--canvas); color: var(--ink); box-shadow: var(--shadow-xs); }

.num-th, .num-td { text-align: right; padding-right: 14px !important; }

.purity-pill {
    display: inline-flex; align-items: center; gap: 6px;
    padding: 3px 9px; border-radius: 4px;
    font-family: var(--font-mono); font-size: 11px; font-weight: 600;
    letter-spacing: var(--tracking-wider);
    border: 1px solid transparent;
}
.purity-pill.p-22 { background: rgba(212,175,55,0.14); color: #b8941f; border-color: rgba(184,148,31,0.30); }
[data-theme="dark"] .purity-pill.p-22 { color: #e6c358; }
.purity-pill.p-21 { background: rgba(196,116,25,0.12); color: var(--warning); border-color: rgba(196,116,25,0.28); }
.purity-pill.p-18 { background: rgba(168,116,80,0.14); color: #a8744f; border-color: rgba(168,116,80,0.30); }
[data-theme="dark"] .purity-pill.p-18 { color: #c89472; }
.purity-pill.p-ag { background: rgba(150,150,160,0.14); color: #757583; border-color: rgba(150,150,160,0.30); }
[data-theme="dark"] .purity-pill.p-ag { color: #b8b8c2; }

.table-foot { display: flex; justify-content: space-between; align-items: center; padding: 16px 22px; border-top: 1px solid var(--line); font-size: 12px; color: var(--ink-faint); }
.seg.sm button, .seg.sm .page-btn { padding: 4px 10px; font-size: 12px; }
.page-btn {
    display: inline-flex; align-items: center; justify-content: center;
    background: transparent; border: none; border-radius: 6px;
    padding: 4px 10px; font-size: 12px; color: var(--ink-soft);
    text-decoration: none; cursor: pointer;
}
.page-btn.active { background: var(--canvas); color: var(--ink); box-shadow: var(--shadow-xs); }
.page-btn[disabled], .page-btn[disabled]:hover { color: var(--ink-ghost); cursor: default; }

.empty-row { padding: 48px 22px; text-align: center; color: var(--ink-faint); font-size: var(--fs-14); }
</style>
}
