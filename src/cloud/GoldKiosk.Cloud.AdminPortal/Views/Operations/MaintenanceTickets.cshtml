@{
    ViewBag.PageTitle = "Maintenance <em>queue.</em>";
    ViewBag.Eyebrow   = "Operations · Field hardware";
    ViewBag.Subtitle  = "Open and scheduled work orders for kiosk hardware — XRF analyzers, scales, dispensers, and printers. Distinct from customer-facing helpdesk tickets.";
    ViewBag.ActiveNav = "operations";
}

@* ── Operations sub-nav + primary action ───────────────────────────── *@
<div style="display:flex; gap:10px; align-items:center; flex-wrap:wrap; margin: -16px 0 22px;">
    <div class="seg seg-tabs">
        <a asp-controller="Operations" asp-action="CollectionTickets">Collections</a>
        <a class="active" asp-controller="Operations" asp-action="MaintenanceTickets">Maintenance</a>
        <a asp-controller="Operations" asp-action="TechnicianManagement">Technicians</a>
        <a asp-controller="Operations" asp-action="SystemHealthCheck">System health</a>
        <a asp-controller="Operations" asp-action="DeploymentTickets">Deployment</a>
        <a asp-controller="Operations" asp-action="LocationConfiguration">Locations</a>
    </div>
    <span style="flex:1;"></span>
    <button type="button" class="btn btn-primary btn-sm" data-action="open-modal" data-target="addWoModal">+ Work order</button>
</div>

@* ── KPI strip ──────────────────────────────────────────────────────── *@
<div class="kpi-strip">
    <div class="kpi-cell">
        <div class="kpi-label">Open WOs<span class="dot" style="background:var(--warning);"></span></div>
        <div class="kpi-value mono">14</div>
        <div class="kpi-foot"><span class="delta delta-up">&#9650; 2</span><span class="label-suffix">vs yesterday</span></div>
    </div>
    <div class="kpi-cell">
        <div class="kpi-label">Scheduled · this week<span class="dot"></span></div>
        <div class="kpi-value mono">11</div>
        <div class="kpi-foot"><span class="label-suffix">4 today · 7 later</span></div>
    </div>
    <div class="kpi-cell">
        <div class="kpi-label">Overdue<span class="dot" style="background:var(--danger);"></span></div>
        <div class="kpi-value mono">2</div>
        <div class="kpi-foot"><span class="label-suffix">WO-2382 · WO-2391</span></div>
    </div>
    <div class="kpi-cell">
        <div class="kpi-label">MTTR<span class="dot"></span></div>
        <div class="kpi-value mono">4.2<span class="unit">h</span></div>
        <div class="kpi-foot"><span class="delta delta-down">&#9660; 0.8h</span><span class="label-suffix">vs 30d avg</span></div>
    </div>
</div>

<section class="card" style="margin-bottom:32px;">
    <div class="fleet-toolbar">
        <span style="text-transform:uppercase; letter-spacing:0.08em;">Priority</span>
        <div class="seg"><button type="button" class="active">All</button><button type="button">P1</button><button type="button">P2</button><button type="button">P3</button></div>
        <span style="text-transform:uppercase; letter-spacing:0.08em;">Device</span>
        <div class="seg"><button type="button" class="active">All</button><button type="button">XRF</button><button type="button">Scale</button><button type="button">Dispenser</button><button type="button">Printer</button><button type="button">ID</button></div>
        <span style="text-transform:uppercase; letter-spacing:0.08em;">Status</span>
        <div class="seg"><button type="button" class="active">Open</button><button type="button">Scheduled</button><button type="button">In progress</button><button type="button">Done · 7d</button></div>
        <span style="flex:1;"></span>
        <button type="button" class="btn btn-ghost btn-sm">Export</button>
    </div>

