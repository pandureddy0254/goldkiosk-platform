@* Hidden anti-forgery form to allow the Work order button to wire up later. *@
<form asp-controller="Operations" asp-action="AddMaintenanceTicket" method="post" style="display:none;" id="addWoForm">
    @Html.AntiForgeryToken()
</form>

@* TODO promote: seg-tabs, dev-pill, sev-pill — already exist in prototype CSS;
    duplicated here so the page renders identically until they're lifted. *@
<style>
    .seg.seg-tabs { display:inline-flex; border:1px solid var(--line-strong); border-radius:var(--radius-md); overflow:hidden; background:var(--canvas-elevated); flex-wrap:wrap; }
    .seg.seg-tabs a { padding:8px 14px; font-size:13px; color:var(--ink-soft); border-right:1px solid var(--line); text-decoration:none; }
    .seg.seg-tabs a:last-child { border-right:none; }
    .seg.seg-tabs a.active { background: var(--ink); color: var(--canvas); }
    .seg.seg-tabs a:hover:not(.active) { background: var(--canvas-sunken); color: var(--ink); }
    .sev-pill { display:inline-flex; align-items:center; gap:4px; font-family:var(--font-mono); font-size:11px; padding:2px 8px; border-radius:var(--radius-xs); font-weight:600; letter-spacing:0.06em; }
    .sev-pill.s-p1 { background: var(--danger-soft); color: var(--danger); }
    .sev-pill.s-p2 { background: var(--warning-soft); color: var(--warning); }
    .sev-pill.s-p3 { background: var(--info-soft); color: var(--info); }
    .dev-pill { display:inline-block; font-family: var(--font-mono); font-size: 11px; padding: 2px 8px; border-radius: var(--radius-xs); letter-spacing: 0.04em; border:1px solid var(--line-strong); color: var(--ink-soft); background: var(--canvas-elevated); }
    .dev-pill.d-xrf   { color: var(--accent);  border-color: var(--accent); }
    .dev-pill.d-scale { color: var(--info);    border-color: var(--info); }
    .dev-pill.d-disp  { color: var(--danger);  border-color: var(--danger); }
    .dev-pill.d-prn   { color: var(--ink-soft); }
    .dev-pill.d-id    { color: var(--warning); border-color: var(--warning); }
</style>
