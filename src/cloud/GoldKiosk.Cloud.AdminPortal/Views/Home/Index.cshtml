@model GoldKiosk.Cloud.AdminPortal.Models.DashboardViewModel
@using System.Globalization
@{
    var inv = CultureInfo.InvariantCulture;
    var today = DateTime.UtcNow;

    // Page chrome
    ViewBag.Eyebrow = today.ToString("dddd, dd MMM yyyy", inv).ToUpperInvariant();
    ViewBag.PageTitle = "Good morning, <em>Aman.</em>";
    ViewBag.Subtitle  = $"Here's how the fleet is performing today — across {Model.ActiveKioskCount} active kiosks in {Model.ActiveKiosks.Count} markets.";
    ViewBag.ActiveNav = "dashboard";
    ViewBag.PageHeadActions =
        "<button class=\"btn btn-ghost btn-sm\">" +
            "<svg width=\"14\" height=\"14\" viewBox=\"0 0 14 14\" fill=\"none\"><path d=\"M2 4L7 9L12 4\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\"/></svg>" +
            " Last 14 days" +
        "</button>" +
        "<a class=\"btn btn-primary btn-sm\" href=\"/KioskManagement/KioskConfiguration\">" +
            "<svg width=\"14\" height=\"14\" viewBox=\"0 0 14 14\" fill=\"none\"><path d=\"M7 3V11M3 7H11\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\"/></svg>" +
            " New kiosk" +
        "</a>";

    // Fleet split (mock-friendly: fall back to plausible numbers when DTO is silent)
    var fleetOnline      = Model.ActiveKioskCount;
    var fleetTotal       = Math.Max(fleetOnline, Model.ActiveKiosks.Count == 0 ? fleetOnline : fleetOnline + 5);
    var fleetMaintenance = Model.ActiveKiosks.Count(k => k.IsMaintenance);
    var fleetOffline     = Math.Max(0, fleetTotal - fleetOnline - fleetMaintenance);

    // Average offer (mock — controller doesn't yet supply it)
    var avgOffer = Model.TodaysTransactionCount > 0
        ? Model.TodaysGrossSales / Model.TodaysTransactionCount
        : 8420m;
}

<!-- KPI strip — institutional / hairline / mono-numeric -->
<div class="kpi-strip">

    <div class="kpi-cell">
        <div class="kpi-label">Total sold today<span class="dot"></span></div>
        <div class="kpi-value">
            <span class="mono">@Model.TodaysGrossSales.ToString("N0", inv)</span><span class="unit">AED</span>
        </div>
        <div class="kpi-foot">
            <span class="delta delta-up">&#9650; 12.4%</span>
            <span class="label-suffix">vs yesterday</span>
        </div>
        <svg class="spark" viewBox="0 0 72 28" preserveAspectRatio="none">
            <path d="M0,22 L8,19 L16,20 L24,15 L32,16 L40,12 L48,13 L56,8 L64,10 L72,4"
                  fill="none" stroke="var(--accent)" stroke-width="1.4" stroke-linecap="round"/>
        </svg>
    </div>

    <div class="kpi-cell">
        <div class="kpi-label">Kiosks online<span class="dot" style="background:var(--success);"></span></div>
        <div class="kpi-value">
            <span class="mono">@fleetOnline</span><span class="unit">/ @fleetTotal</span>
        </div>
        <div class="kpi-foot">
            <span class="delta delta-flat">@fleetMaintenance maint &middot; @fleetOffline off</span>
        </div>
        <svg class="spark" viewBox="0 0 72 28" preserveAspectRatio="none">
            <path d="M0,12 L14,11 L28,13 L42,9 L56,12 L72,8" fill="none" stroke="var(--success)" stroke-width="1.4" stroke-linecap="round"/>
        </svg>
    </div>

    <div class="kpi-cell">
        <div class="kpi-label">Transactions today<span class="dot"></span></div>
        <div class="kpi-value"><span class="mono">@Model.TodaysTransactionCount.ToString("N0", inv)</span></div>
        <div class="kpi-foot">
            <span class="delta delta-up">&#9650; 8.1%</span>
            <span class="label-suffix"><span class="mono">@Math.Max(0, Model.TodaysTransactionCount - 252).ToString("N0", inv)</span> settled</span>
        </div>
        <svg class="spark" viewBox="0 0 72 28" preserveAspectRatio="none">
            <path d="M0,20 L7,18 L14,21 L21,15 L28,12 L35,15 L42,11 L49,13 L56,8 L63,9 L72,5"
                  fill="none" stroke="var(--accent)" stroke-width="1.4" stroke-linecap="round"/>
        </svg>
    </div>

    <div class="kpi-cell">
        <div class="kpi-label">Average offer<span class="dot" style="background:var(--danger);"></span></div>
        <div class="kpi-value">
            <span class="mono">@avgOffer.ToString("N0", inv)</span><span class="unit">AED</span>
        </div>
        <div class="kpi-foot">
            <span class="delta delta-down">&#9660; 2.3%</span>
            <span class="label-suffix">22K &middot; spot fell</span>
        </div>
        <svg class="spark" viewBox="0 0 72 28" preserveAspectRatio="none">
            <path d="M0,8 L8,10 L16,7 L24,11 L32,10 L40,14 L48,13 L56,17 L64,16 L72,20"
                  fill="none" stroke="var(--danger)" stroke-width="1.4" stroke-linecap="round"/>
        </svg>
    </div>

</div>

<!-- Sales chart + live feed -->
<div class="split-2-1">

    <section class="card">
        <header class="card-head">
            <div>
                <h2 class="card-title">Sales &middot; last 14 days</h2>
                <div class="card-meta" style="margin-top:6px;">
                    <span>AED <span class="mono">4,824,118</span> total &middot; <span style="color:var(--success);">&#9650; 12.4%</span> period-over-period</span>
                </div>
            </div>
            <div style="display:flex; gap:6px;">
                <button class="btn btn-ghost btn-sm" style="border-color:var(--accent); color:var(--accent);">14d</button>
                <button class="btn btn-ghost btn-sm">30d</button>
                <button class="btn btn-ghost btn-sm">90d</button>
                <button class="btn btn-ghost btn-sm">All</button>
            </div>
        </header>
        <div class="card-body">
            <div class="chart">
                <svg viewBox="0 0 700 260" preserveAspectRatio="none">
                    <defs>
                        <linearGradient id="areaGrad" x1="0" x2="0" y1="0" y2="1">
                            <stop offset="0%"   stop-color="var(--accent)" stop-opacity="0.35"/>
                            <stop offset="100%" stop-color="var(--accent)" stop-opacity="0"/>
                        </linearGradient>
                    </defs>
                    <g stroke="var(--line)" stroke-dasharray="2 4">
                        <line x1="0" x2="700" y1="40"  y2="40"/>
                        <line x1="0" x2="700" y1="100" y2="100"/>
                        <line x1="0" x2="700" y1="160" y2="160"/>
                        <line x1="0" x2="700" y1="220" y2="220"/>
                    </g>
                    <path d="M0,180 L50,160 L100,170 L150,140 L200,130 L250,100 L300,110 L350,80 L400,90 L450,60 L500,70 L550,40 L600,55 L650,35 L700,30 L700,260 L0,260 Z"
                          fill="url(#areaGrad)"/>
                    <path d="M0,180 L50,160 L100,170 L150,140 L200,130 L250,100 L300,110 L350,80 L400,90 L450,60 L500,70 L550,40 L600,55 L650,35 L700,30"
                          fill="none" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                    <circle cx="700" cy="30" r="5" fill="var(--canvas)" stroke="var(--accent)" stroke-width="2"/>
                    <circle cx="700" cy="30" r="2" fill="var(--accent)"/>
                    <g font-family="var(--font-mono)" font-size="10" fill="var(--ink-faint)">
                        <text x="0"   y="252">May 11</text>
                        <text x="170" y="252">May 14</text>
                        <text x="340" y="252">May 17</text>
                        <text x="510" y="252">May 20</text>
                        <text x="660" y="252" text-anchor="end">May 24</text>
                    </g>
                    <g transform="translate(580, 8)">
                        <rect x="0" y="0" width="110" height="32" rx="6" fill="var(--canvas-elevated)" stroke="var(--accent)"/>
                        <text x="10" y="13" font-size="9" font-family="var(--font-sans)" fill="var(--ink-faint)" text-transform="uppercase">TODAY</text>
                        <text x="10" y="25" font-size="12" font-family="var(--font-mono)" font-weight="500" fill="var(--accent)">AED @Model.TodaysGrossSales.ToString("N0", inv)</text>
                    </g>
                </svg>
            </div>
        </div>
    </section>

    <section class="card">
        <header class="card-head">
            <div>
                <h2 class="card-title">Live transaction feed</h2>
                <div class="card-meta" style="margin-top:6px;">
                    <span class="dot-pulse"></span><span>Streaming</span>
                </div>
            </div>
            <a asp-controller="Sales" asp-action="PreciousMetal" style="font-size:13px; color:var(--accent);">View all &rarr;</a>
        </header>

        <div class="feed">
            @if (Model.RecentTransactions.Count == 0)
            {
                <div class="feed-row" style="grid-template-columns: 1fr;">
                    <span style="color:var(--ink-faint); padding:24px 0; text-align:center;">No recent transactions.</span>
                </div>
            }
            else
            {
                foreach (var t in Model.RecentTransactions.Take(6))
                {
                    var statusClass = t.Status?.Equals("settled", StringComparison.OrdinalIgnoreCase) == true ? "ok"
                                    : t.Status?.Equals("pending", StringComparison.OrdinalIgnoreCase) == true ? "pending"
                                    : t.Status?.Equals("failed",  StringComparison.OrdinalIgnoreCase) == true ? "fail"
                                    : "ok";
                    var statusGlyph = statusClass switch
                    {
                        "ok"      => "✓",
                        "pending" => "⏳",
                        "fail"    => "!",
                        _         => "✓"
                    };

                    <div class="feed-row">
                        <span class="feed-code mono">@t.TransactionCode</span>
                        <div class="feed-meta"><strong>@t.Kind</strong> &middot; @t.OccurredOn.ToString("dd MMM, HH:mm", inv)</div>
                        <span class="feed-amount mono">AED @t.NetPayout.ToString("N0", inv)</span>
                        <span class="feed-status @statusClass">@statusGlyph</span>
                    </div>
                }
            }
        </div>
    </section>

</div>

<!-- Fleet status -->
<section class="card" style="margin-bottom:32px;">
    <header class="card-head">
        <div>
            <h2 class="card-title">Fleet status</h2>
            <div class="card-meta" style="margin-top:6px;">
                <span><span class="mono">@fleetTotal</span> kiosks &middot; 9 markets &middot; <span class="mono">@Model.TodaysTransactionCount.ToString("N0", inv)</span> tx today</span>
            </div>
        </div>
        <a asp-controller="KioskManagement" asp-action="KioskConfiguration" style="font-size:13px; color:var(--accent);">Fleet view &rarr;</a>
    </header>

    <div class="fleet-toolbar">
        <span class="legend"><span class="sw" style="background:var(--success);"></span><span class="mono">@fleetOnline</span> online</span>
        <span class="legend"><span class="sw" style="background:var(--warning);"></span><span class="mono">@fleetMaintenance</span> maintenance</span>
        <span class="legend"><span class="sw" style="background:var(--danger);"></span><span class="mono">@fleetOffline</span> offline</span>
        <span style="flex:1;"></span>
        <span style="text-transform:uppercase; letter-spacing:0.08em;">View</span>
        <div class="seg">
            <button class="active">Grid</button>
            <button>List</button>
            <button>Map</button>
        </div>
        <span style="text-transform:uppercase; letter-spacing:0.08em;">Region</span>
        <div class="seg">
            <button class="active">All &middot; UAE</button>
            <button>DXB</button>
            <button>AUH</button>
            <button>SHJ</button>
            <button>Northern</button>
        </div>
    </div>

    <div style="padding:20px 22px 24px;">
        <div class="kiosk-grid">
            @if (Model.ActiveKiosks.Count == 0)
            {
                <div style="grid-column: 1 / -1; padding:32px 0; text-align:center; color:var(--ink-faint);">
                    No kiosks on the floor yet.
                </div>
            }
            else
            {
                foreach (var k in Model.ActiveKiosks)
                {
                    var tileClass = k.IsMaintenance ? "kiosk-tile maint"
                                  : (k.Status?.Equals("offline", StringComparison.OrdinalIgnoreCase) == true ? "kiosk-tile offline" : "kiosk-tile online");
                    var chipLabel = k.IsMaintenance ? "Maintenance"
                                  : (k.Status?.Equals("offline", StringComparison.OrdinalIgnoreCase) == true ? "Offline" : "Online");
                    var lastTx    = k.LastPing?.ToString("HH:mm", inv) ?? "—";
                    var sparkPath = k.IsMaintenance
                        ? "M0,12 L70,12"
                        : (chipLabel == "Offline" ? "M0,14 L20,16 L30,18 L40,18 L70,18" : "M0,18 L10,15 L20,14 L30,11 L40,10 L50,8 L60,6 L70,4");
                    var sparkColour = k.IsMaintenance ? "var(--warning)" : (chipLabel == "Offline" ? "var(--danger)" : "var(--success)");

                    <div class="@tileClass">
                        <span class="kiosk-chip">@chipLabel</span>
                        <div class="kiosk-id">
                            <span class="kiosk-code mono">@k.Code</span>
                            <span class="kiosk-name">@k.FriendlyName</span>
                        </div>
                        <div class="kiosk-metric">
                            <div><span class="num">@(k.IsMaintenance ? "—" : Math.Abs(k.Code.GetHashCode() % 40).ToString())</span><span class="unit">@(k.IsMaintenance ? "XRF cal." : "tx today")</span></div>
                            <svg class="tile-spark" viewBox="0 0 70 22" preserveAspectRatio="none">
                                <path d="@sparkPath" fill="none" stroke="@sparkColour" stroke-width="1.4" stroke-linecap="round" @(k.IsMaintenance ? "stroke-dasharray=\"3 3\"" : "") />
                            </svg>
                        </div>
                        <div class="kiosk-foot">last tx &middot; <span class="mono">@lastTx</span></div>
                    </div>
                }
            }
        </div>
    </div>
</section>

<!-- Bottom: secondary panels -->
<div class="split-2-1">
    <section class="card">
        <header class="card-head">
            <div>
                <h2 class="card-title">Tickets requiring attention</h2>
                <div class="card-meta" style="margin-top:6px;"><span><span class="mono">@Model.OpenTickets</span> open &middot; <span class="mono">@Model.UnresolvedExceptions</span> critical</span></div>
            </div>
            <a asp-controller="HelpDesk" asp-action="Ticket" style="font-size:13px; color:var(--accent);">Helpdesk &rarr;</a>
        </header>
        <div class="feed">
            <div class="feed-row" style="grid-template-columns:auto 1fr auto auto;">
                <span class="feed-code mono" style="color:var(--danger);">#HD-118</span>
                <div class="feed-meta"><strong>XRF calibration drift</strong> &middot; K-DXB-02 &middot; raised 14m ago</div>
                <span class="feed-amount" style="font-size:12px; color:var(--ink-faint);">L1 &middot; Critical</span>
                <span class="feed-status fail">!</span>
            </div>
            <div class="feed-row" style="grid-template-columns:auto 1fr auto auto;">
                <span class="feed-code mono" style="color:var(--warning);">#HD-117</span>
                <div class="feed-meta"><strong>Cash dispenser jam</strong> &middot; K-AUH-02 &middot; raised 1h ago</div>
                <span class="feed-amount" style="font-size:12px; color:var(--ink-faint);">L2 &middot; High</span>
                <span class="feed-status pending">&#9203;</span>
            </div>
            <div class="feed-row" style="grid-template-columns:auto 1fr auto auto;">
                <span class="feed-code mono">#HD-116</span>
                <div class="feed-meta"><strong>ID-scanner LED flicker</strong> &middot; K-DXB-04 &middot; raised 3h ago</div>
                <span class="feed-amount" style="font-size:12px; color:var(--ink-faint);">L3 &middot; Normal</span>
                <span class="feed-status ok">&#10003;</span>
            </div>
        </div>
    </section>

    <section class="card">
        <header class="card-head">
            <div>
                <h2 class="card-title">Live metals &middot; spot</h2>
                <div class="card-meta" style="margin-top:6px;"><span class="dot-pulse" style="background:var(--accent);"></span><span>NSE refresh &middot; <span class="mono">12s</span> ago</span></div>
            </div>
        </header>
        <div style="padding:8px 22px 22px;">
            <div style="display:flex; justify-content:space-between; align-items:baseline; padding:14px 0; border-bottom:1px solid var(--line);">
                <div>
                    <div style="font-family:var(--font-display); font-size:18px;">Gold &middot; 24K</div>
                    <div style="font-size:12px; color:var(--ink-faint);">per gram &middot; AED</div>
                </div>
                <div style="text-align:right;">
                    <div class="mono" style="font-size:22px; font-weight:500;">295.42</div>
                    <div class="mono" style="font-size:12px; color:var(--danger);">&#9660; 0.42 (-0.14%)</div>
                </div>
            </div>
            <div style="display:flex; justify-content:space-between; align-items:baseline; padding:14px 0; border-bottom:1px solid var(--line);">
                <div>
                    <div style="font-family:var(--font-display); font-size:18px;">Gold &middot; 22K</div>
                    <div style="font-size:12px; color:var(--ink-faint);">per gram &middot; AED</div>
                </div>
                <div style="text-align:right;">
                    <div class="mono" style="font-size:22px; font-weight:500;">270.80</div>
                    <div class="mono" style="font-size:12px; color:var(--danger);">&#9660; 0.38</div>
                </div>
            </div>
            <div style="display:flex; justify-content:space-between; align-items:baseline; padding:14px 0;">
                <div>
                    <div style="font-family:var(--font-display); font-size:18px;">Silver &middot; 999</div>
                    <div style="font-size:12px; color:var(--ink-faint);">per gram &middot; AED</div>
                </div>
                <div style="text-align:right;">
                    <div class="mono" style="font-size:22px; font-weight:500;">3.62</div>
                    <div class="mono" style="font-size:12px; color:var(--success);">&#9650; 0.04 (+1.12%)</div>
                </div>
            </div>
        </div>
    </section>
</div>
