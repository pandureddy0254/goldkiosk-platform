@model GoldKiosk.Cloud.AdminPortal.Models.Layout.LayoutChromeViewModel

<header class="header">
    <a class="brand" asp-controller="Home" asp-action="Index">
        <span class="brand-mark"></span>
        <span class="brand-name">
            <span class="brand-primary">Gold <em>Kiosk</em></span>
            <span class="brand-suffix">Admin · Operator portal</span>
        </span>
    </a>

    <div class="search">
        <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
            <circle cx="7" cy="7" r="5" stroke="currentColor" stroke-width="1.5" />
            <path d="M11 11L14 14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" />
        </svg>
        <input type="text" placeholder="Search kiosks, customers, transactions…" aria-label="Search" />
        <kbd>⌘K</kbd>
    </div>

    <div class="header-right">
        <button class="icon-btn has-badge" title="Notifications" aria-label="Notifications">
            <svg width="18" height="18" viewBox="0 0 18 18" fill="none">
                <path d="M9 2C6.5 2 4.5 4 4.5 6.5V9L3 11.5V12H15V11.5L13.5 9V6.5C13.5 4 11.5 2 9 2zM7.5 14C7.5 14.8 8.2 15.5 9 15.5C9.8 15.5 10.5 14.8 10.5 14"
                      stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <span class="badge"></span>
        </button>

        <button class="theme-toggle" data-action="toggle-theme" title="Toggle theme" aria-label="Toggle theme">
            <span class="ring"></span>
        </button>

        <div class="user-menu">
            <button class="user-chip" data-action="toggle-user-menu" aria-haspopup="true" aria-expanded="false">
                <span class="avatar">@Model.UserInitials</span>
                <span style="font-size:13px; font-weight:500;">@Model.UserDisplayName</span>
                <svg width="12" height="12" viewBox="0 0 12 12" fill="none" style="color:var(--ink-faint);">
                    <path d="M3 4.5L6 7.5L9 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
                </svg>
            </button>
            <div class="user-menu-popover" role="menu">
                <div class="user-menu-head">
                    <div class="avatar avatar-lg">@Model.UserInitials</div>
                    <div>
                        <div class="user-menu-name">@Model.UserDisplayName</div>
                        <div class="user-menu-role"><span class="role-pill r-admin">@Model.UserPrimaryRole</span></div>
                    </div>
                </div>
                <a class="user-menu-item" asp-controller="Account" asp-action="Profile">
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><circle cx="8" cy="5" r="2.5" stroke="currentColor" stroke-width="1.5"/><path d="M3 14C3 11.5 5 10 8 10C11 10 13 11.5 13 14" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
                    Profile
                </a>
                <a class="user-menu-item" asp-controller="TenantSettings" asp-action="Index">
                    <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><circle cx="8" cy="8" r="6" stroke="currentColor" stroke-width="1.5"/><path d="M5 8L7 10L11 6" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    Tenant settings
                </a>
                <div class="user-menu-divider"></div>
                <form asp-controller="Account" asp-action="Logout" method="post" class="user-menu-form">
                    @Html.AntiForgeryToken()
                    <button type="submit" class="user-menu-item user-menu-danger">
                        <svg width="16" height="16" viewBox="0 0 16 16" fill="none">
                            <path d="M10 4V3C10 2.4 9.6 2 9 2H4C3.4 2 3 2.4 3 3V13C3 13.6 3.4 14 4 14H9C9.6 14 10 13.6 10 13V12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                            <path d="M7 8H14M14 8L11.5 5.5M14 8L11.5 10.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                        Sign out
                    </button>
                </form>
            </div>
        </div>
    </div>
</header>
