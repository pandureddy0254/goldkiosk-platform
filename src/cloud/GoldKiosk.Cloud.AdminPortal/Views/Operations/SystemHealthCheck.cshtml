@{
    ViewBag.PageTitle = "Backend <em>system health.</em>";
    ViewBag.Eyebrow   = "Operations · Platform infrastructure";
    ViewBag.Subtitle  = "Status of every service in the Gold Kiosk platform — API, workers, queues, integrations, and their dependency graph.";
    ViewBag.ActiveNav = "operations";
}

<div style="display:flex; gap:10px; align-items:center; flex-wrap:wrap; margin: -16px 0 22px;">
    <div class="seg seg-tabs">
        <a asp-controller="Operations" asp-action="CollectionTickets">Collections</a>
        <a asp-controller="Operations" asp-action="MaintenanceTickets">Maintenance</a>
        <a asp-controller="Operations" asp-action="TechnicianManagement">Technicians</a>
        <a class="active" asp-controller="Operations" asp-action="SystemHealthCheck">System health</a>
        <a asp-controller="Operations" asp-action="DeploymentTickets">Deployment</a>
        <a asp-controller="Operations" asp-action="LocationConfiguration">Locations</a>
    </div>
</div>

<div class="kpi-strip">
    <div class="kpi-cell">
        <div class="kpi-label">Services up<span class="dot" style="background:var(--success);"></span></div>
        <div class="kpi-value mono">11<span class="unit">/ 12</span></div>
        <div class="kpi-foot"><span class="label-suffix">1 degraded · 0 down</span></div>
    </div>
    <div class="kpi-cell">
        <div class="kpi-label">Degraded<span class="dot" style="background:var(--warning);"></span></div>
        <div class="kpi-value mono">1</div>
        <div class="kpi-foot"><span class="label-suffix">Reports matview · slow</span></div>
    </div>
    <div class="kpi-cell">
        <div class="kpi-label">Queue depth<span class="dot"></span></div>
        <div class="kpi-value mono">142</div>
        <div class="kpi-foot"><span class="delta delta-down">&#9660; 38</span><span class="label-suffix">Outbox · 4 DLQ</span></div>
    </div>
    <div class="kpi-cell">
        <div class="kpi-label">Platform p99<span class="dot"></span></div>
        <div class="kpi-value mono">284<span class="unit">ms</span></div>
        <div class="kpi-foot"><span class="delta delta-down">&#9660; 18ms</span><span class="label-suffix">SLO · 400ms</span></div>
    </div>
</div>

