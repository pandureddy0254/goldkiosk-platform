@model DailySalesReportViewModel
@using System.Globalization
@{
    var report = Model ?? throw new InvalidOperationException("This report view requires a model.");

    var inv = CultureInfo.InvariantCulture;

    ViewBag.PageTitle = "Daily <em>sales.</em>";
    ViewBag.Eyebrow   = "R-01 · DAILY SALES (PRECIOUS METAL) · REFRESH · 15 MIN";
    ViewBag.Subtitle  = "Per-day revenue, transaction count, and customer reach across all UAE regions. Backed by mv_daily_sales — rebuilt every 15 minutes from the transactions ledger.";
    ViewBag.ActiveNav = "reports";

    var rows  = report.Rows ?? new List<DailySalesReportRow>();
    var from  = report.From?.ToString("yyyy-MM-dd", inv) ?? "";
    var to    = report.To?.ToString("yyyy-MM-dd", inv) ?? "";

    var rangeLabel = (report.From, report.To) switch
    {
        ({ } f, { } t) => $"{f:dd MMM} – {t:dd MMM}",
        _ => "Last 30 days"
    };
}

@section Head {
    @await Html.PartialAsync("_ReportDetailStyles")
}

<!-- Breadcrumb -->
<div class="breadcrumb">
    <a asp-controller="Reports" asp-action="Index">Reports library</a>
    <span class="sep">&rsaquo;</span>
    <span>R-01 &middot; Daily Sales</span>
</div>

<!-- Filter / actions -->
<form method="get" asp-controller="Reports" asp-action="PreciousMetal"
      class="report-filter">
    @Html.AntiForgeryToken()
    <label>From <input type="date" name="from" value="@from" /></label>
    <label>To <input type="date" name="to" value="@to" /></label>
    <button type="submit" class="btn btn-primary btn-sm">Apply</button>
    <a class="btn btn-ghost btn-sm" asp-controller="Reports" asp-action="PreciousMetal">Reset</a>
    <span style="flex:1;"></span>
    <button type="button" class="btn btn-ghost btn-sm">Export &middot; CSV</button>
    <button type="button" class="btn btn-ghost btn-sm">Export &middot; PDF</button>
</form>

<!-- Primary chart -->
<section class="card" style="margin-bottom:24px;">
    <header class="card-head">
        <div>
            <h2 class="card-title">Revenue &middot; @rangeLabel</h2>
            <div class="card-meta" style="margin-top:6px;">
                <span><span class="mono">@report.TotalPayout.ToString("N0", inv)</span> AED total &middot;
                <span style="color:var(--success);">&#9650; 14.2%</span> vs prior period &middot;
                <span class="mono">@report.TransactionCount.ToString("N0", inv)</span> transactions</span>
            </div>
        </div>
        <div style="display:flex; gap:6px;">
            <button class="btn btn-ghost btn-sm">7d</button>
            <button class="btn btn-ghost btn-sm" style="border-color:var(--accent); color:var(--accent);">30d</button>
            <button class="btn btn-ghost btn-sm">90d</button>
            <button class="btn btn-ghost btn-sm">YTD</button>
        </div>
    </header>
    <div class="card-body">
        <div class="chart">
            <svg viewBox="0 0 1000 280" preserveAspectRatio="none">
                <defs>
                    <linearGradient id="dGrad" x1="0" x2="0" y1="0" y2="1">
                        <stop offset="0%"   stop-color="var(--accent)" stop-opacity="0.32"/>
                        <stop offset="100%" stop-color="var(--accent)" stop-opacity="0"/>
                    </linearGradient>
                </defs>
                <g stroke="var(--line)" stroke-dasharray="2 4">
                    <line x1="0" x2="1000" y1="40"  y2="40"/>
                    <line x1="0" x2="1000" y1="100" y2="100"/>
                    <line x1="0" x2="1000" y1="160" y2="160"/>
                    <line x1="0" x2="1000" y1="220" y2="220"/>
                </g>
                <path d="M0,200 L34,195 L68,210 L102,188 L136,182 L170,175 L204,190 L238,168 L272,160 L306,172 L340,148 L374,140 L408,158 L442,130 L476,122 L510,138 L544,108 L578,100 L612,120 L646,90 L680,82 L714,98 L748,68 L782,60 L816,78 L850,48 L884,40 L918,55 L952,32 L986,22 L1000,18 L1000,280 L0,280 Z" fill="url(#dGrad)"/>
                <path d="M0,200 L34,195 L68,210 L102,188 L136,182 L170,175 L204,190 L238,168 L272,160 L306,172 L340,148 L374,140 L408,158 L442,130 L476,122 L510,138 L544,108 L578,100 L612,120 L646,90 L680,82 L714,98 L748,68 L782,60 L816,78 L850,48 L884,40 L918,55 L952,32 L986,22 L1000,18" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                <circle cx="1000" cy="18" r="5" fill="var(--canvas)" stroke="var(--accent)" stroke-width="2"/>
                <circle cx="1000" cy="18" r="2" fill="var(--accent)"/>
            </svg>
        </div>
    </div>
</section>

<!-- KPI strip -->
<div class="kpi-strip">
    <div class="kpi-cell">
        <div class="kpi-label">Total revenue<span class="dot"></span></div>
        <div class="kpi-value"><span class="mono">@report.TotalPayout.ToString("N0", inv)</span><span class="unit">AED</span></div>
        <div class="kpi-foot"><span class="delta delta-up">&#9650; 14.2%</span><span class="label-suffix">vs prior 30d</span></div>
        <svg class="spark" viewBox="0 0 72 28" preserveAspectRatio="none"><path d="M0,22 L8,20 L16,21 L24,17 L32,18 L40,13 L48,14 L56,9 L64,7 L72,4" fill="none" stroke="var(--accent)" stroke-width="1.4" stroke-linecap="round"/></svg>
    </div>
    <div class="kpi-cell">
        <div class="kpi-label">Total grams<span class="dot" style="background:var(--success);"></span></div>
        <div class="kpi-value"><span class="mono">@report.TotalWeightG.ToString("N0", inv)</span><span class="unit">g</span></div>
        <div class="kpi-foot"><span class="delta delta-up">&#9650; 9.6%</span><span class="label-suffix">22K &middot; majority</span></div>
        <svg class="spark" viewBox="0 0 72 28" preserveAspectRatio="none"><path d="M0,20 L12,18 L24,16 L36,14 L48,12 L60,9 L72,6" fill="none" stroke="var(--success)" stroke-width="1.4" stroke-linecap="round"/></svg>
    </div>
    <div class="kpi-cell">
        <div class="kpi-label">Total tx<span class="dot"></span></div>
        <div class="kpi-value"><span class="mono">@report.TransactionCount.ToString("N0", inv)</span></div>
        <div class="kpi-foot"><span class="delta delta-up">&#9650; 8.1%</span><span class="label-suffix">daily avg</span></div>
        <svg class="spark" viewBox="0 0 72 28" preserveAspectRatio="none"><path d="M0,20 L7,18 L14,21 L21,15 L28,14 L35,16 L42,12 L49,14 L56,9 L63,10 L72,6" fill="none" stroke="var(--accent)" stroke-width="1.4" stroke-linecap="round"/></svg>
    </div>
    <div class="kpi-cell">
        <div class="kpi-label">Customers<span class="dot" style="background:var(--success);"></span></div>
        <div class="kpi-value"><span class="mono">@report.CustomerCount.ToString("N0", inv)</span></div>
        <div class="kpi-foot"><span class="delta delta-up">&#9650; 0.6pp</span><span class="label-suffix">unique walk-ins</span></div>
        <svg class="spark" viewBox="0 0 72 28" preserveAspectRatio="none"><path d="M0,10 L14,9 L28,10 L42,8 L56,7 L72,5" fill="none" stroke="var(--success)" stroke-width="1.4" stroke-linecap="round"/></svg>
    </div>
</div>

<!-- Breakdown card -->
<section class="card" style="margin-bottom:24px;">
    <header class="card-head">
        <div>
            <h2 class="card-title">Breakdown by day</h2>
            <div class="card-meta" style="margin-top:6px;"><span>Per-day rollup of revenue, weight, customers, transactions</span></div>
        </div>
    </header>
    <div style="overflow-x:auto;">
        <table class="report-table">
            <thead>
                <tr>
                    <th>Sale date</th>
                    <th>Kind</th>
                    <th class="num">Tx</th>
                    <th class="num">Customers</th>
                    <th class="num">Weight (g)</th>
                    <th class="num">Payout AED</th>
                </tr>
            </thead>
            <tbody>
                @if (rows.Count == 0)
                {
                    <tr><td colspan="6" style="text-align:center; padding:32px 18px; color:var(--ink-faint);">No sales in the selected window.</td></tr>
                }
                else
                {
                    foreach (var r in rows)
                    {
                        <tr>
                            <td class="mono"><strong>@r.SaleDate.ToString("yyyy-MM-dd", inv)</strong></td>
                            <td>@r.Kind</td>
                            <td class="num mono">@r.TransactionCount.ToString("N0", inv)</td>
                            <td class="num mono">@r.CustomerCount.ToString("N0", inv)</td>
                            <td class="num mono">@r.TotalWeightG.ToString("N3", inv)</td>
                            <td class="num mono">@r.TotalPayout.ToString("N2", inv)</td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</section>

@await Html.PartialAsync("_ReportMetaCard", new ReportMetaCardModel {
    ReportCode = "R-01",
    Matview    = "mv_daily_sales",
    Cadence    = "Every 15 minutes",
    Rows       = report.TransactionCount
})
