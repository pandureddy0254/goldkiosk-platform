@page "/offer"

<div class="screen screen-offer">
    <div class="offer-header">
        <span class="mono-label"><span class="pulse-dot"></span>@L["offer.chip.ai_verified"]</span>
        <span class="mono-label">@(Store.Offer?.Amount.Currency ?? "")</span>
    </div>

    @if (Store.Offer is { } offer)
    {
        <div class="offer-center">
            <div class="offer-halo"></div>
            <span class="mono-label offer-kicker">@L["offer.kicker"]</span>
            <div class="offer-amount value-number serif-hero">
                <span class="amount-main">@AmountMain(offer)</span><span class="amount-minor">@AmountMinor(offer)</span>
            </div>

            <div class="offer-chips">
                @if (offer.Verified)
                {
                    <span class="chip">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <circle cx="12" cy="12" r="9" /><path d="m8.5 12.2 2.4 2.4 4.6-5" />
                        </svg>
                        @L["offer.chip.verified"]
                    </span>
                }
                @if (offer.LivePrice)
                {
                    <span class="chip">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <path d="M3 12h4l2.5-6 4 12 2.5-6h5" />
                        </svg>
                        @L["offer.chip.live_price"]
                    </span>
                }
                <span class="chip @(_expired ? "chip-attention" : null)">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <rect x="5" y="10.5" width="14" height="9.5" rx="2" /><path d="M8 10.5V8a4 4 0 0 1 8 0v2.5" />
                    </svg>
                    <span class="chip-mono">@(_expired ? L["offer.chip.expired"] : _countdown)</span>
                </span>
            </div>

            <button class="link-button" @onclick="OpenExplainAsync">@L["offer.explain.link"]</button>
        </div>

        <div class="screen-actions">
            <button class="btn-primary" disabled="@(_busy || _expired)" @onclick="AcceptAsync">
                @L["offer.accept"]
            </button>
            <button class="btn-glass" disabled="@_busy" @onclick="DeclineAsync">
                @L["offer.return"]
            </button>
        </div>

        <Sheet Visible="_showExplain" Title="@L["offer.sheet.title"]" CloseLabel="@L["common.close"]" OnClose="CloseExplain">
            @if (_explanation is null)
            {
                <div class="sheet-loading">
                    <OrbitalRings Small="true" />
                    <p>@L["offer.sheet.loading"]</p>
                </div>
            }
            else
            {
                <p>@_explanation.Explanation</p>
                @if (offer.PawnTerms is { } pawn)
                {
                    <div class="pawn-terms">
                        <h4 class="mono-label">@L["offer.pawn.title"]</h4>
                        <div class="pawn-grid">
                            <span>@L["offer.pawn.monthly_fee"]</span><span class="value-number">@pawn.MonthlyFee.Display</span>
                            <span>@L["offer.pawn.apr"]</span><span class="value-number">@FormatApr(pawn.AprPercent)</span>
                            <span>@L["offer.pawn.total_repayment"]</span><span class="value-number">@pawn.TotalRepayment.Display</span>
                            <span>@L["offer.pawn.due_date"]</span><span class="value-number">@FormatDate(pawn.DueDate)</span>
                        </div>
                    </div>
                }
                <p class="disclaimer">@_explanation.Disclaimer</p>
            }
        </Sheet>
    }
</div>
