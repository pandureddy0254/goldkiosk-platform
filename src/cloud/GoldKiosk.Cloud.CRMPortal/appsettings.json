{
  // Secrets NEVER live in this file. Every "<from-user-secrets>" placeholder is
  // supplied via `dotnet user-secrets` in dev and Azure Key Vault (managed identity)
  // in production. The legacy repo committed live SES keys and an Ed25519 private
  // key — none of that material is carried here; rotate before any cut-over.
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*",
  "DefaultCurrency": "USD",
  "Ses": {
    "Region": "<from-user-secrets>",
    "AccessKeyId": "<from-user-secrets>",
    "SecretAccessKey": "<from-user-secrets>",
    "FromEmail": "<from-user-secrets>",
    "FromName": "Gold Kiosk",
    "ReplyTo": ""
  },
  "Proposal": {
    "DefaultUnitPriceUsd": 12500,
    "OfficeAddress": "8 The Green, STE B, Dover, Delaware, 19901, USA",
    "PhoneUsa": "+1 (800) 969-0506",
    "PhoneIndia": "+91 (800) 202-2939",
    "SigneeName": "Nakia Geller",
    "SigneeTitle": "CEO"
  },
  "License": {
    "Issuer": "goldkiosk.crm",
    "DefaultTermDays": 365,
    // The active signing kid and per-kid key material come from user-secrets /
    // Key Vault. JWKS shape per kid (both values base64 of raw 32-byte Ed25519 keys):
    //   "License:ActiveKid"                       = "<kid>"
    //   "License:Keys:<kid>:PublicKeyBase64"      = "<publishable public key>"
    //   "License:Keys:<kid>:PrivateKeyBase64"     = "<SECRET private key>"
    "ActiveKid": "<from-user-secrets>",
    "Keys": {}
  }
}
