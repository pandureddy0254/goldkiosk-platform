                <tr><td class="mono" style="color:var(--accent);">WO-2398</td><td class="mono">K-SHJ-01</td><td><span class="dev-pill d-xrf">XRF</span></td><td style="font-size:13px;">Quarterly calibration · reference foil set</td><td><span class="sev-pill s-p3">P3</span></td><td style="font-size:13px;">Hassan Al Naqbi</td><td class="mono" style="font-size:12px;">Tomorrow · 09:30</td><td class="mono" style="font-size:12px;">~ 2h</td><td><span class="status-pill s-pending">Scheduled</span></td></tr>
