{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      { "Name": "Console" },
      {
        "Name": "File",
        "Args": {
          "path": "./logs/cloud-api-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 30
        }
      }
    ],
    "Enrich": [ "FromLogContext" ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    // Secret (contains credentials) — dev: dotnet user-secrets; prod: Key Vault.
    "goldkiosk": ""
  },
  "Jwt": {
    // Secret — dev: dotnet user-secrets set "Jwt:Key" …; prod: Key Vault. Min 32 chars.
    "Key": "",
    "Issuer": "goldkiosk-cloud",
    "Audience": "goldkiosk-kiosk",
    "TokenLifetimeMinutes": 60
  },
  "GoldApi": {
    // Secret — dev: dotnet user-secrets set "GoldApi:ApiKey" …; empty = degrade to DB rates.
    "ApiKey": "",
    "BaseUrl": "https://www.goldapi.io/api",
    "IntervalHours": 24,
    "EnableSync": true
  },
  "Region": {
    "DefaultCurrency": "INR"
  },
  "Offers": {
    "DefaultMarginPercent": 92.0,
    "RoundingStep": 5.0,
    "LockSeconds": 300
  },
  "AiService": {
    "BaseUrl": "https://goldkiosk-ai.smartlawyer.ai/api/v1",
    "TimeoutSeconds": 120,
    "MinConfidence": 0.75,
    "GoldDetectionModel": "openai",
    "MaxImageBytes": 10485760
  },
  "LiveAgent": {
    "ReviewTtlSeconds": 300
  },
  "KioskConfig": {
    "MinKarat": 10,
    "MaxKarat": 24,
    "PawnEnabled": true,
    "CryptoEnabled": false,
    "PayoutMethods": [ "bank_transfer", "cash" ]
  }
}
