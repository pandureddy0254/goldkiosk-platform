@{
    ViewBag.PageTitle = "Technician <em>roster.</em>";
    ViewBag.Eyebrow   = "Operations · Workforce";
    ViewBag.Subtitle  = "Field-engineering team across the GCC, with live status, today's job count, and skills coverage. Schedule and reassign work orders directly.";
    ViewBag.ActiveNav = "operations";
}

<div style="display:flex; gap:10px; align-items:center; flex-wrap:wrap; margin: -16px 0 22px;">
    <div class="seg seg-tabs">
        <a asp-controller="Operations" asp-action="CollectionTickets">Collections</a>
        <a asp-controller="Operations" asp-action="MaintenanceTickets">Maintenance</a>
        <a class="active" asp-controller="Operations" asp-action="TechnicianManagement">Technicians</a>
        <a asp-controller="Operations" asp-action="SystemHealthCheck">System health</a>
        <a asp-controller="Operations" asp-action="DeploymentTickets">Deployment</a>
        <a asp-controller="Operations" asp-action="LocationConfiguration">Locations</a>
    </div>
    <span style="flex:1;"></span>
    <button type="button" class="btn btn-primary btn-sm" data-action="open-modal" data-target="addTechModal">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M7 3V11M3 7H11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
        Add technician
    </button>
</div>

<div class="kpi-strip">
    <div class="kpi-cell">
        <div class="kpi-label">Active technicians<span class="dot" style="background:var(--success);"></span></div>
        <div class="kpi-value mono">10</div>
        <div class="kpi-foot"><span class="label-suffix">8 on-shift now</span></div>
    </div>
    <div class="kpi-cell">
        <div class="kpi-label">On-route now<span class="dot" style="background:var(--accent);"></span></div>
        <div class="kpi-value mono">4</div>
        <div class="kpi-foot"><span class="label-suffix">DXB · AUH · SHJ · RAK</span></div>
    </div>
    <div class="kpi-cell">
        <div class="kpi-label">Avg. travel<span class="dot"></span></div>
        <div class="kpi-value mono">1.8<span class="unit">h</span></div>
        <div class="kpi-foot"><span class="delta delta-down">&#9660; 0.2h</span><span class="label-suffix">vs 30d avg</span></div>
    </div>
    <div class="kpi-cell">
        <div class="kpi-label">Jobs completed · 7d<span class="dot"></span></div>
        <div class="kpi-value mono">82</div>
        <div class="kpi-foot"><span class="delta delta-up">&#9650; 11</span><span class="label-suffix">11.7 / tech avg</span></div>
    </div>
</div>

