@* TODO promote: tech-card grid + heatmap — already live in prototype CSS;
    repeated here so the page renders standalone. *@
<style>
    .seg.seg-tabs { display:inline-flex; border:1px solid var(--line-strong); border-radius:var(--radius-md); overflow:hidden; background:var(--canvas-elevated); flex-wrap:wrap; }
    .seg.seg-tabs a { padding:8px 14px; font-size:13px; color:var(--ink-soft); border-right:1px solid var(--line); text-decoration:none; }
    .seg.seg-tabs a:last-child { border-right:none; }
    .seg.seg-tabs a.active { background: var(--ink); color: var(--canvas); }
    .seg.seg-tabs a:hover:not(.active) { background: var(--canvas-sunken); color: var(--ink); }
    .tech-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 14px; margin-bottom: 32px; }
    .tech-card { position: relative; background: var(--canvas-elevated); border:1px solid var(--line); border-radius: var(--radius-lg); padding: 18px 20px; min-height: 160px; transition: border-color var(--dur-fast); }
    .tech-card:hover { border-color: var(--accent); }
    .tech-top { display:flex; justify-content:space-between; align-items:center; margin-bottom:12px; }
    .tech-avatar { width: 38px; height: 38px; background: var(--accent-soft); color: var(--accent); font-weight:500; }
    .tech-stat { display:inline-flex; align-items:center; gap:4px; font-size:11px; padding: 2px 8px; border-radius: var(--radius-full); letter-spacing:0.06em; }
    .tech-stat::before { content:""; width:6px; height:6px; border-radius:50%; background: currentColor; display:inline-block; }
    .tech-stat.s-idle    { background: var(--info-soft);    color: var(--info); }
    .tech-stat.s-onroute { background: var(--accent-soft);  color: var(--accent); }
    .tech-stat.s-onsite  { background: var(--success-soft); color: var(--success); }
    .tech-stat.s-offduty { background: var(--canvas-sunken); color: var(--ink-faint); }
    .tech-name { font-family: var(--font-display); font-size: 18px; line-height: 1.2; margin-bottom: 4px; }
    .tech-region { font-size: 12px; color: var(--ink-faint); margin-bottom: 12px; }
    .tech-meta { display:flex; justify-content:space-between; font-size:12px; color: var(--ink-soft); padding: 8px 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); margin-bottom: 10px; }
    .tech-skills { display:flex; gap:6px; flex-wrap:wrap; }
    .skill { font-family: var(--font-mono); font-size: 10px; padding: 2px 8px; background: var(--canvas-sunken); border-radius: var(--radius-xs); color: var(--ink-soft); letter-spacing:0.04em; }
    .heatmap { width: 100%; border-collapse: separate; border-spacing: 3px; }
    .heatmap th { font-size: 11px; color: var(--ink-faint); font-weight: 400; text-align: center; padding: 4px 0; font-family: var(--font-mono); letter-spacing: 0.04em; }
    .heatmap tbody th { text-align: left; padding-right: 14px; font-size: 12px; color: var(--ink-soft); font-family: var(--font-sans); white-space: nowrap; }
    .h { width: 36px; height: 22px; border-radius: var(--radius-xs); background: var(--canvas-sunken); }
    .h.h-0 { background: var(--canvas-sunken); }
    .h.h-1 { background: var(--accent-soft); }
    .h.h-2 { background: rgba(184,148,31,0.4); }
    [data-theme="dark"] .h.h-2 { background: rgba(212,175,55,0.4); }
    .h.h-3 { background: var(--accent); }
    .legend-h { display:inline-block; width:14px; height:10px; border-radius:2px; }
    .legend-h.h-0 { background: var(--canvas-sunken); border:1px solid var(--line); }
</style>
