@inject GoldKiosk.Cloud.AdminPortal.Services.Invitations.IUserInvitationService Invitations
@inject GoldKiosk.Infrastructure.Common.ICurrentUserService CurrentUser
@{
    ViewBag.PageTitle = "User <em>management.</em>";
    ViewBag.Eyebrow   = "Administration · Identity";
    ViewBag.Subtitle  = "Invite employees, assign predefined RBAC roles, and audit access. Only the primary admin (Owner) can change roles for users with elevated permissions.";
    ViewBag.ActiveNav = "user-management";

    var pendingInvites = new List<GoldKiosk.Cloud.AdminPortal.Services.Invitations.PendingInviteRow>();
    if (CurrentUser.TenantId is Guid tid)
        pendingInvites = await Invitations.ListPendingAsync(tid, Context.RequestAborted);
}

<div style="display:flex; gap:10px; align-items:center; flex-wrap:wrap; margin: -16px 0 22px;">
    <div class="seg seg-tabs">
        <a class="active" asp-controller="UserManagement" asp-action="ProfileRoles">Users</a>
        <a asp-controller="UserManagement" asp-action="RoleMaster">Role master</a>
        <a asp-controller="UserManagement" asp-action="AccessControl">Access control</a>
    </div>
    <span style="flex:1;"></span>
    <button type="button" class="btn btn-ghost btn-sm">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M7 1V13M1 7H13" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
        Bulk invite
    </button>
    <a class="btn btn-primary btn-sm" asp-controller="UserManagement" asp-action="Invite">
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none"><path d="M7 3V11M3 7H11" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"/></svg>
        Invite user
    </a>
</div>

@* ── KPI strip ─────────────────────────────────────────────────────── *@
<div class="kpi-strip">
    <div class="kpi-cell">
        <div class="kpi-label">Active users<span class="dot" style="background:var(--success);"></span></div>
        <div class="kpi-value mono">14</div>
        <div class="kpi-foot"><span class="delta delta-up">&#9650; 2</span><span class="label-suffix">this month</span></div>
    </div>
    <div class="kpi-cell">
        <div class="kpi-label">Pending invites<span class="dot" style="background:var(--warning);"></span></div>
        <div class="kpi-value mono">3</div>
        <div class="kpi-foot"><span class="label-suffix">oldest · 4 days</span></div>
    </div>
    <div class="kpi-cell">
        <div class="kpi-label">Role definitions<span class="dot"></span></div>
        <div class="kpi-value mono">6<span class="unit">presets</span></div>
        <div class="kpi-foot"><span class="label-suffix">+ 2 custom roles</span></div>
    </div>
    <div class="kpi-cell">
        <div class="kpi-label">Failed sign-ins · 7d<span class="dot" style="background:var(--danger);"></span></div>
        <div class="kpi-value mono">7</div>
        <div class="kpi-foot"><span class="delta delta-down">&#9660; 4</span><span class="label-suffix">vs prior 7d</span></div>
    </div>
</div>

@* ── Predefined role cards ─────────────────────────────────────────── *@
<div class="eyebrow" style="margin-bottom:14px;">Predefined RBAC roles</div>
<div class="role-grid">
    <div class="role-card">
        <span class="role-pill r-admin">Primary admin</span>
        <h4>Owner</h4>
        <p class="role-desc">Full access. Manages billing, tenant settings, all users and roles. Only one per tenant &mdash; bound to the activation key.</p>
        <div class="role-stats"><span>1 user</span><span><strong>All</strong> modules</span></div>
    </div>
    <div class="role-card">
        <span class="role-pill r-manager">Manager</span>
        <h4>Branch manager</h4>
        <p class="role-desc">Operates a region or branch. Approves payouts, manages kiosk schedules, reviews tickets. Cannot edit roles.</p>
        <div class="role-stats"><span>3 users</span><span><strong>9</strong> modules</span></div>
    </div>
    <div class="role-card">
        <span class="role-pill r-operator">Operator</span>
        <h4>Kiosk operator</h4>
        <p class="role-desc">Day-to-day floor staff. Views fleet status, processes transactions, raises tickets. Read-only on customers.</p>
        <div class="role-stats"><span>6 users</span><span><strong>5</strong> modules</span></div>
    </div>
    <div class="role-card">
        <span class="role-pill r-analyst">Analyst</span>
        <h4>Finance &amp; ops analyst</h4>
        <p class="role-desc">Reads everything. Runs reports, exports CSV, no write permissions. Suitable for finance and compliance.</p>
        <div class="role-stats"><span>2 users</span><span><strong>All</strong> modules · RO</span></div>
    </div>
    <div class="role-card">
        <span class="role-pill r-support">Support</span>
        <h4>Helpdesk agent</h4>
        <p class="role-desc">Owns tickets, SOS workflow, customer feedback. Can mask/unmask PII with reason logged.</p>
        <div class="role-stats"><span>2 users</span><span><strong>3</strong> modules</span></div>
    </div>
    <div class="role-card">
        <span class="role-pill r-auditor">Auditor</span>
        <h4>External auditor</h4>
        <p class="role-desc">Time-boxed read-only access to audit logs and reports. Cannot see PII. Auto-revokes after window expires.</p>
        <div class="role-stats"><span>0 users</span><span><strong>2</strong> modules · time-boxed</span></div>
    </div>
</div>

