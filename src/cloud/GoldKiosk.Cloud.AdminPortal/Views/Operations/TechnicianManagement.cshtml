@* ── Daily heatmap ────────────────────────────────────────────────── *@
<section class="card" style="margin-bottom:32px;">
    <header class="card-head">
        <div>
            <h2 class="card-title">Daily schedule · today</h2>
            <div class="card-meta" style="margin-top:6px;"><span>Technician &times; hour · UAE Standard Time</span></div>
        </div>
        <div style="display:flex; gap:6px;">
            <button type="button" class="btn btn-ghost btn-sm" style="border-color:var(--accent); color:var(--accent);">Today</button>
            <button type="button" class="btn btn-ghost btn-sm">Tomorrow</button>
            <button type="button" class="btn btn-ghost btn-sm">Week</button>
        </div>
    </header>
