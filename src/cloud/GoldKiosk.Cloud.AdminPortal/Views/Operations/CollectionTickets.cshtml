@* ── Hidden form for generating a route (visual stub; wire to AddCollectionRun) ─── *@
<form asp-controller="Operations" asp-action="AddCollectionRun" method="post" style="display:none;" id="addRunForm">
    @Html.AntiForgeryToken()
</form>

@section Scripts {
    <script>
        // No-op placeholder for the Generate route button until the modal is built.
        document.querySelectorAll('[data-action="open-modal"]').forEach(function (btn) {
            btn.addEventListener('click', function () {
                console.info('Open modal:', btn.getAttribute('data-target'));
            });
        });
    </script>
}

@* TODO promote: page-scoped styles (seg-tabs, map-card, bar, route-*) — once
    used by 2+ views, lift to main.css.  Most are already proven elsewhere in
    the prototype; we only keep what's missing locally. *@
<style>
    .seg.seg-tabs { display:inline-flex; border:1px solid var(--line-strong); border-radius:var(--radius-md); overflow:hidden; background:var(--canvas-elevated); flex-wrap:wrap; }
    .seg.seg-tabs a { padding:8px 14px; font-size:13px; color:var(--ink-soft); border-right:1px solid var(--line); text-decoration:none; }
    .seg.seg-tabs a:last-child { border-right:none; }
    .seg.seg-tabs a.active { background: var(--ink); color: var(--canvas); }
    .seg.seg-tabs a:hover:not(.active) { background: var(--canvas-sunken); color: var(--ink); }
    .map-card { background: var(--canvas-sunken); border:1px solid var(--line); border-radius: var(--radius-md); padding: 6px; }
    .sw { display:inline-block; width:8px; height:8px; border-radius:50%; margin-right:4px; vertical-align:middle; }
    .bar { display:inline-block; width:78px; height: 5px; background: var(--canvas-sunken); border-radius:2px; overflow:hidden; vertical-align:middle; margin-right:8px; }
    .bar-fill { height: 100%; border-radius:2px; }
    .route-item { padding: 14px 0; border-bottom: 1px solid var(--line); }
    .route-item:last-child { border-bottom: none; }
    .route-head { display:flex; justify-content:space-between; align-items:center; margin-bottom:6px; font-weight:500; }
    .route-meta { font-size: 13px; color: var(--ink-soft); margin-bottom: 10px; }
    .route-prog { height: 4px; background: var(--canvas-sunken); border-radius:2px; margin-bottom: 6px; overflow:hidden; }
    .route-fill { height:100%; background: var(--accent); border-radius:2px; transition: width var(--dur-med); }
    .route-foot { display:flex; justify-content:space-between; font-size:12px; color: var(--ink-faint); }
</style>
