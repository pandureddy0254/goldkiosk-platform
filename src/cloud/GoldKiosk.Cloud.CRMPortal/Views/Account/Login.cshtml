@model GoldKiosk.Cloud.CRMPortal.Models.ViewModels.LoginViewModel
@{
    Layout = null;
    ViewData["Title"] = "Sign in";
}
<!doctype html>
<html lang="en" data-theme="light">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Sign in — Gold Kiosk CRM</title>
    <link rel="stylesheet" href="~/css/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/main.css"   asp-append-version="true" />
    <script src="~/js/theme.js" defer></script>
</head>
<body>
    <button class="theme-toggle login-theme-toggle" data-action="toggle-theme" title="Toggle theme" aria-label="Toggle theme">
        <span class="ring"></span>
    </button>

    <div class="login-shell">

        <aside class="login-art">
            <div class="filigree"></div>
            <div class="corner-mark"><span>v1.0 · INTERNAL · CRM</span></div>

            <div class="login-art-top">
                <span class="brand-mark"></span>
                <div class="wordmark">
                    Gold <em>Kiosk</em>
                    <span class="corp">CRM · Internal sales portal</span>
                </div>
            </div>

            <div class="kiosk-hero">
                <img src="~/img/openart-image_1772788530268_8895b112_1772788531283_931adba7.png" alt="Gold Kiosk · precious-metals self-service terminal" />
                <span class="shimmer"></span>
            </div>

            <div class="hero-tag t1"><span class="dot"></span><span class="line"></span><span>Leads · sourced</span></div>
            <div class="hero-tag t2"><span>Partners · onboarded</span><span class="line"></span><span class="dot"></span></div>
            <div class="hero-tag t3"><span class="dot"></span><span class="line"></span><span>Keys · provisioned</span></div>

            <div class="login-art-stats">
                <div class="login-art-stat"><div class="num">38</div><div class="lbl">Open leads · GCC</div></div>
                <div class="login-art-stat"><div class="num">14</div><div class="lbl">Live partners</div></div>
                <div class="login-art-stat"><div class="num">3.2M</div><div class="lbl">USD · MRR pipeline</div></div>
            </div>
        </aside>

        <main class="login-form-shell login-internal">
            <div class="login-form">
                <div class="eyebrow">CRM · Internal staff</div>
                <h1>Welcome <em>back.</em></h1>
                <p class="lede">Sign in with your AI Kiosks staff account. This portal is invite-only — your manager seeds new accounts; there is no self-onboarding.</p>

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="warn-callout" style="margin-bottom:20px;">
                        <div class="ico">!</div>
                        <div class="body">
                            @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                            {
                                <div>@err.ErrorMessage</div>
                            }
                        </div>
                    </div>
                }

                <form asp-action="Login" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" asp-for="ReturnUrl" />

                    <div class="field">
                        <label asp-for="Email">Work email</label>
                        <input asp-for="Email" type="email" autocomplete="email" placeholder="you@goldkiosk.com" />
                    </div>

                    <div class="field">
                        <label asp-for="Password">Password</label>
                        <input asp-for="Password" type="password" autocomplete="current-password" placeholder="••••••••••" />
                    </div>

                    <div class="login-row">
                        <label class="checkbox">
                            <input asp-for="KeepSignedIn" type="checkbox" />
                            <span>Keep me signed in for 8 hours</span>
                        </label>
                        <a href="#">Forgot?</a>
                    </div>

                    <button class="btn btn-gold btn-block" type="submit">
                        Sign in
                        <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8H13M13 8L9 4M13 8L9 12" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg>
                    </button>

                    <div class="login-foot">
                        <span>© AI Kiosks International Inc. 2026</span>
                        <span style="font-family:var(--font-mono); font-size:11px;">paluvala@@goldkiosk.com</span>
                    </div>
                </form>
            </div>
        </main>
    </div>
</body>
</html>
