<Window x:Class="GoldKiosk.Kiosk.UI.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        WindowStartupLocation="CenterScreen"
        SizeToContent="WidthAndHeight">
  <Grid Margin="60">
    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
      <Image Source="Assets/goldkiosk-logo.png" Width="320" Height="320"
             RenderOptions.BitmapScalingMode="HighQuality">
        <Image.Effect>
          <DropShadowEffect Color="#38E1FF" BlurRadius="48" ShadowDepth="0" Opacity="0.35" />
        </Image.Effect>
      </Image>
      <TextBlock x:Name="StatusText"
                 Text="Starting…"
                 HorizontalAlignment="Center"
                 Margin="0,28,0,0"
                 FontFamily="Segoe UI Semibold, Segoe UI"
                 FontSize="26"
                 Foreground="#F4F7FB">
        <TextBlock.Effect>
          <DropShadowEffect Color="#000000" BlurRadius="14" ShadowDepth="0" Opacity="0.85" />
        </TextBlock.Effect>
      </TextBlock>
    </StackPanel>
  </Grid>
</Window>
